@{
    ViewData["Title"] = "BEMO";
    var conectado = ViewBag.Conectado is true;
    var departamentos = ViewBag.Departamentos as IEnumerable<BEMO.Entidades.DepartamentoUbicacion>
        ?? Enumerable.Empty<BEMO.Entidades.DepartamentoUbicacion>();
}

<div class="text-center">
    <p>Conexión: @(conectado ? "correcta" : "fallida")</p>

    <select class="form-select" aria-label="Departamento de ubicación">
        <option value="">Seleccione un departamento</option>
        @foreach (var departamento in departamentos)
        {
            <option value="@departamento.IdDepartamentoUbicacion">
                @departamento.NombreDepartamentoUbicacion
            </option>
        }
    </select>
</div>
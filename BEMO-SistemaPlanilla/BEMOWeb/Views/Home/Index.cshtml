@model BEMOWeb.Models.LoginViewModel;

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
    var conectado = ViewBag.Conectado is true;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - BEMO</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-[#F7F1E5] px-4 py-8 text-[#381F12]">
    <main class="mx-auto flex min-h-[calc(100vh-4rem)] w-full max-w-5xl items-center justify-center">
        <section class="grid w-full overflow-hidden rounded-[28px] border border-[#E3D2AE] bg-white shadow-[0_24px_70px_rgba(104,64,38,0.16)] md:grid-cols-[1.05fr_0.95fr]">
            <article class="relative flex min-h-[360px] flex-col justify-between overflow-hidden bg-[#9F5F2F] px-8 py-10 text-white md:min-h-[560px] md:px-12 md:py-12">
                <div class="absolute -left-20 -top-20 h-64 w-64 rounded-full bg-[#D7A660]/25"></div>
                <div class="absolute -bottom-24 -right-16 h-72 w-72 rounded-full bg-[#381F12]/20"></div>

                <div class="relative">
                    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.28em] text-[#F7E9C9]">Sistema de planilla</p>
                    <h1 class="max-w-sm text-4xl font-bold leading-tight md:text-5xl">Bienvenidos a BEMO</h1>
                    <p class="mt-5 max-w-sm text-base leading-7 text-[#F5E8D2]">
                        Gestiona la información laboral desde una plataforma clara y segura.
                    </p>
                </div>

                <img src="~/Images/logo_blanco.webp"
                     asp-append-version="true"
                     alt="Logo de BEMO"
                     class="relative mx-auto mt-10 h-40 w-40 object-contain drop-shadow-lg md:h-48 md:w-48">
            </article>

            <article class="flex items-center px-7 py-10 sm:px-10 md:px-12">
                <div class="w-full">
                    <div class="mb-8">
                        <div class="mb-6 flex items-center justify-between gap-4">
                            <span class="text-sm font-semibold uppercase tracking-[0.18em] text-[#804C2C]">BEMO</span>
                            <span class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium @(conectado ? "border-green-200 bg-green-50 text-green-700" : "border-red-200 bg-red-50 text-red-700")">
                                <span class="h-2 w-2 rounded-full @(conectado ? "bg-green-500" : "bg-red-500")"></span>
                                @(conectado ? "Conectado" : "Sin conexión")
                            </span>
                        </div>
                        <h2 class="text-3xl font-bold text-[#381F12]">Iniciar sesión</h2>
                        <p class="mt-2 text-sm leading-6 text-[#804C2C]">
                            Ingresa tus credenciales para continuar.
                        </p>
                    </div>

                    <form asp-controller="Login" asp-action="Login" method="post" class="space-y-5">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-700"></div>

                        <div>
                            <label asp-for="Correo" class="mb-2 block text-sm font-semibold text-[#684026]">
                                Correo electrónico
                            </label>
                            <input asp-for="Correo"
                                   type="email"
                                   autocomplete="email"
                                   placeholder="ejemplo@bemo.com"
                                   class="block w-full rounded-xl border border-[#D7C49E] bg-[#FFFDF8] px-4 py-3 text-[#381F12] outline-none transition placeholder:text-[#B8A88A] focus:border-[#9F5F2F] focus:ring-4 focus:ring-[#CE8E41]/20"
                                   required>
                            <span asp-validation-for="Correo" class="mt-1 block text-sm text-red-600"></span>
                        </div>

                        <div>
                            <label asp-for="Clave" class="mb-2 block text-sm font-semibold text-[#684026]">
                                Contraseña
                            </label>
                            <input asp-for="Clave"
                                   type="password"
                                   autocomplete="current-password"
                                   placeholder="Ingresa tu contraseña"
                                   class="block w-full rounded-xl border border-[#D7C49E] bg-[#FFFDF8] px-4 py-3 text-[#381F12] outline-none transition placeholder:text-[#B8A88A] focus:border-[#9F5F2F] focus:ring-4 focus:ring-[#CE8E41]/20"
                                   required>
                            <span asp-validation-for="Clave" class="mt-1 block text-sm text-red-600"></span>
                        </div>

                        <button type="submit"
                                class="mt-2 w-full cursor-pointer rounded-xl bg-[#9F5F2F] px-4 py-3.5 text-sm font-bold text-white shadow-[0_10px_24px_rgba(159,95,47,0.25)] transition hover:-translate-y-0.5 hover:bg-[#804C2C] focus:outline-none focus:ring-4 focus:ring-[#CE8E41]/30 active:translate-y-0">
                            Iniciar sesión
                        </button>
                    </form>
                </div>
            </article>
        </section>
    </main>
</body>
</html>

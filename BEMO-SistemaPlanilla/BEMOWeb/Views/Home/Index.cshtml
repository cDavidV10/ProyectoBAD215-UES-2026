@model BEMOWeb.Models.LoginViewModel;

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
    var conectado = ViewBag.Conectado is true;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - BEMO</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-[#F7F1E5] px-4 py-8 text-[#381F12]">
    <svg aria-hidden="true" class="hidden">
        <symbol id="icon-eye" viewBox="0 0 24 24">
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
            <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
        </symbol>
        <symbol id="icon-eye-closed" viewBox="0 0 24 24">
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M21 9c-2.4 2.667 -5.4 4 -9 4c-3.6 0 -6.6 -1.333 -9 -4" />
            <path d="M3 15l2.5 -3.8" />
            <path d="M21 14.976l-2.492 -3.776" />
            <path d="M9 17l.5 -4" />
            <path d="M15 17l-.5 -4" />
        </symbol>
    </svg>
    <main class="mx-auto flex min-h-[calc(100vh-4rem)] w-full max-w-5xl items-center justify-center">
        <section class="grid w-full overflow-hidden rounded-[28px] border border-[#E3D2AE] bg-white shadow-[0_24px_70px_rgba(104,64,38,0.16)] md:grid-cols-[1.05fr_0.95fr]">
            <article class="relative flex min-h-[360px] flex-col justify-between overflow-hidden bg-[#9F5F2F] px-8 py-10 text-white md:min-h-[560px] md:px-12 md:py-12">
                <div class="absolute -left-20 -top-20 h-64 w-64 rounded-full bg-[#D7A660]/25"></div>
                <div class="absolute -bottom-24 -right-16 h-72 w-72 rounded-full bg-[#381F12]/20"></div>
    
                <div class="relative flex items-center justify-between gap-4">
                    <div class="flex items-center justify-center gap-2">
                        <span class="flex size-12 items-center justify-center rounded-lg bg-[#381F12]/35">
                            <img src="~/Images/logo_blanco.webp"
                                 asp-append-version="true"
                                 alt="Logo de BEMO"
                                 class="size-12 object-contain">
                        </span>
                        <div class="flex-col items-center justify-center">
                            <span class="text-lg font-bold">Corporacion Textil Salvadoreña</span>
                            <p class="mb-3 text-sm font-semibold uppercase tracking-[0.28em] text-[#F7E9C9]">Sistema de planilla</p>
                        </div>
                    </div>
                </div>

                <div class="relative mt-12">
                    
                    <h1 class="max-w-sm text-3xl font-bold leading-tight md:text-4xl">BIENVENIDOS</h1>
                    <p class="mt-5 max-w-sm text-base leading-7 text-[#F5E8D2]">
                        Gestiona la información laboral desde una plataforma clara y segura.
                    </p>
                </div>
            </article>

            <article class="flex items-center px-7 py-10 sm:px-10 md:px-12">
                <div class="w-full">
                    <div class="mb-8">
                        <div class="mb-6 flex items-center justify-between gap-4">
                            <span class="text-sm font-semibold uppercase tracking-[0.18em] text-[#804C2C]">BEMO</span>
                            <span class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium @(conectado ? "border-green-200 bg-green-50 text-green-700" : "border-red-200 bg-red-50 text-red-700")">
                                <span class="h-2 w-2 rounded-full @(conectado ? "bg-green-500" : "bg-red-500")"></span>
                                @(conectado ? "Conectado" : "Sin conexión")
                            </span>
                        </div>
                        <h2 class="text-3xl font-bold text-[#381F12]">Iniciar sesión</h2>
                        <p class="mt-2 text-sm leading-6 text-[#804C2C]">
                            Ingresa tus credenciales para continuar.
                        </p>
                    </div>

                    <form asp-controller="Login" asp-action="Login" method="post" class="space-y-5">
                        @Html.AntiForgeryToken()
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="ModelOnly"
                                 role="alert"
                                 class="rounded-lg bg-red-50 px-4 py-3 text-sm font-medium text-red-700"></div>
                        }

                        <div>
                            <label asp-for="NombreUsuario" class="mb-2 block text-sm font-semibold text-[#684026]">
                                Usuario
                            </label>
                            <input asp-for="NombreUsuario"
                                   type="text"
                                   autocomplete="off"
                                   placeholder="usuario123"
                                   class="block w-full rounded-xl border border-[#D7C49E] bg-[#FFFDF8] px-4 py-3 text-[#381F12] outline-none transition placeholder:text-[#B8A88A] focus:border-[#9F5F2F] focus:ring-4 focus:ring-[#CE8E41]/20"
                                   required>
                            <span asp-validation-for="NombreUsuario" class="mt-1 block text-sm text-red-600"></span>
                        </div>

                        <div>
                            <label asp-for="Clave" class="mb-2 block text-sm font-semibold text-[#684026]">
                                Contraseña
                            </label>
                            <div class="relative">
                                <input asp-for="Clave"
                                       type="password"
                                       autocomplete="current-password"
                                       placeholder="Ingresa tu contraseña"
                                       class="block w-full rounded-xl border border-[#D7C49E] bg-[#FFFDF8] px-4 py-3 pr-20 text-[#381F12] outline-none transition placeholder:text-[#B8A88A] focus:border-[#9F5F2F] focus:ring-4 focus:ring-[#CE8E41]/20"
                                       data-password-field required>
                                <button type="button"
                                        class="absolute right-2 top-1/2 -translate-y-1/2 p-2 text-[#804C2C] hover:text-[#381F12]"
                                        data-password-toggle data-password-target="Clave" aria-label="Mostrar contraseña" title="Mostrar contraseña" aria-pressed="false">
                                    <svg class="bemo-icon-sm" viewBox="0 0 24 24" data-password-icon><use href="#icon-eye"></use></svg>
                                    <span class="sr-only" data-password-label>Mostrar contraseña</span>
                                </button>
                            </div>
                            <span asp-validation-for="Clave" class="mt-1 block text-sm text-red-600"></span>
                        </div>

                        <button type="submit"
                                class="mt-2 w-full cursor-pointer rounded-xl bg-[#9F5F2F] px-4 py-3.5 text-sm font-bold text-white shadow-[0_10px_24px_rgba(159,95,47,0.25)] transition hover:-translate-y-0.5 hover:bg-[#804C2C] focus:outline-none focus:ring-4 focus:ring-[#CE8E41]/30 active:translate-y-0">
                            Iniciar sesión
                        </button>
                    </form>
                </div>
            </article>
        </section>
    </main>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>

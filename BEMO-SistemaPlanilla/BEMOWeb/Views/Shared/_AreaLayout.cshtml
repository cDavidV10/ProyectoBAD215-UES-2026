<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BEMO</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-[#F7F1E5] text-[#381F12]">
    <header class="bg-[#9F5F2F] text-white shadow-md">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-4">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-3">
                <img src="~/Images/logo_blanco.webp" asp-append-version="true" alt="BEMO" class="size-11 rounded-lg bg-[#381F12]/30 object-contain" />
                <span>
                    <span class="block text-lg font-bold">BEMO</span>
                    <span class="block text-xs uppercase tracking-[0.2em] text-[#F5E8D2]">Sistema de planilla</span>
                </span>
            </a>
            <div class="flex items-center gap-4">
                <span class="text-sm text-[#F5E8D2]">@User.Identity?.Name</span>
                <form asp-area="" asp-controller="Login" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-lg border border-white/40 px-4 py-2 text-sm font-semibold transition hover:bg-white/15 focus:outline-none focus:ring-2 focus:ring-white cursor-pointer">
                        Cerrar sesión
                    </button>
                </form>
            </div>
        </div>
    </header>

    <main class="mx-auto min-h-[calc(100vh-9rem)] max-w-6xl px-5 py-10">
        @RenderBody()
    </main>

    <footer class="border-t border-[#E3D2AE] bg-white/70">
        <div class="mx-auto max-w-6xl px-5 py-4 text-sm text-[#804C2C]">
            &copy; 2026 BEMO - Corporación Textil Salvadoreña
        </div>
    </footer>
</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BEMO</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slate-100 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
        <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
            <a class="text-lg font-bold text-slate-900" asp-area="" asp-controller="Home" asp-action="Index">BEMOWeb</a>
            <div class="flex items-center gap-5 text-sm font-medium">
                <a class="text-slate-600 hover:text-blue-600" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                <a class="text-slate-600 hover:text-blue-600" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
            </div>
        </nav>
    </header>

    <main class="mx-auto max-w-6xl px-4">
        @RenderBody()
    </main>

    <footer class="mt-10 border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-6xl px-4 py-5 text-sm text-slate-500">
            &copy; 2026 - BEMOWeb
                </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

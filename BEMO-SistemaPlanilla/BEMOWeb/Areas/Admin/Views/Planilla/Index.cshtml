@using System.Globalization
@using System.Collections.Generic
@model BEMOWeb.Models.PlanillaIndexModel

@{
    ViewData["Title"] = "Planilla";
    var mensaje = TempData["Mensaje"] as string;
    var error = TempData["Error"] as string;
    var inicio = Model.TotalRegistros == 0 ? 0 : ((Model.PaginaActual - 1) * Model.TamanoPagina) + 1;
    var fin = Math.Min(Model.PaginaActual * Model.TamanoPagina, Model.TotalRegistros);

    string Fecha(DateOnly fecha) => fecha.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);

    string UrlPagina(int pagina)
    {
        var parametros = new List<string> { $"pagina={pagina}" };
        if (!string.IsNullOrWhiteSpace(Model.EstadoSeleccionado))
        {
            parametros.Add($"estado={Uri.EscapeDataString(Model.EstadoSeleccionado)}");
        }

        return "?" + string.Join("&", parametros);
    }
}

<div class="space-y-6">
    <header class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
        <div>
            <p class="bemo-kicker">Administracion</p>
            <h1 class="bemo-title mt-2">Planilla</h1>
            <p class="bemo-subtitle mt-2">Crea, calcula, revisa y cierra las planillas quincenales.</p>
        </div>
        <a asp-action="Calcular" class="bemo-button bemo-button-primary self-start">
            <svg class="bemo-icon" viewBox="0 0 24 24">
                <use href="#icon-calculator"></use>
            </svg>
            Nueva planilla
        </a>
    </header>

    @if (!string.IsNullOrWhiteSpace(mensaje) || !string.IsNullOrWhiteSpace(error))
    {
        <div class="bemo-notifications" aria-live="polite" aria-atomic="true">
            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="bemo-notification bemo-notification-success" data-notification data-notification-seconds="5"
                     role="status">
                    <div class="bemo-notification-body">
                        <svg class="bemo-icon shrink-0" viewBox="0 0 24 24">
                            <use href="#icon-check"></use>
                        </svg>
                        <div class="min-w-0 flex-1">
                            <p>@mensaje</p><span class="bemo-notification-countdown" data-notification-countdown></span>
                        </div>
                        <button type="button" class="bemo-notification-close" data-notification-close
                                aria-label="Cerrar notificacion">&times;</button>
                    </div>
                    <div class="bemo-notification-progress" data-notification-progress></div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="bemo-notification bemo-notification-error" data-notification data-notification-seconds="7"
                     role="alert">
                    <div class="bemo-notification-body">
                        <svg class="bemo-icon shrink-0" viewBox="0 0 24 24">
                            <use href="#icon-ban"></use>
                        </svg>
                        <div class="min-w-0 flex-1">
                            <p>@error</p><span class="bemo-notification-countdown" data-notification-countdown></span>
                        </div>
                        <button type="button" class="bemo-notification-close" data-notification-close
                                aria-label="Cerrar notificacion">&times;</button>
                    </div>
                    <div class="bemo-notification-progress" data-notification-progress></div>
                </div>
            }
        </div>
    }

    <section class="bemo-card p-4">
        <form method="get" asp-action="Index"
              class="grid gap-4 md:grid-cols-[minmax(0,1fr)_minmax(14rem,18rem)_auto] md:items-end">
            <div>
                <label class="bemo-label" for="estado">Estado de la planilla</label>
                <select id="estado" name="estado" class="bemo-select">
                    <option value="">Todos los estados</option>
                    <option value="BORRADOR"
                            selected="@(string.Equals(Model.EstadoSeleccionado, "BORRADOR", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                        Borrador</option>
                        <option value="CALCULADA"
                                selected="@(string.Equals(Model.EstadoSeleccionado, "CALCULADA", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                            Calculada</option>
                            <option value="CERRADA"
                                    selected="@(string.Equals(Model.EstadoSeleccionado, "CERRADA", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                Cerrada</option>
                            </select>
                        </div>
                        <div class="bemo-info h-fit">
                            <svg class="bemo-icon shrink-0" viewBox="0 0 24 24">
                                <use href="#icon-info"></use>
                            </svg>
                            Solo se permiten periodos del 1 al 15 o del 16 al ultimo dia del mes.
                        </div>
                        <button type="submit" class="bemo-button bemo-button-secondary">Aplicar filtro</button>
                    </form>
                </section>

                <section class="bemo-card overflow-hidden">
                    <div class="bemo-table-wrap">
                        <table class="bemo-table min-w-[1100px]">
                            <thead>
                                <tr>
                                    <th>Planilla</th>
                                    <th>Periodo</th>
                                    <th>Fecha de pago</th>
                                    <th>Empleados</th>
                                    <th>Total bruto</th>
                                    <th>Deducciones</th>
                                    <th>Neto</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Planillas.Count == 0)
                                {
                                    <tr>
                                        <td colspan="9" class="py-8 text-center text-[#684026]">No hay planillas que coincidan con el
                                            filtro.</td>
                                        </tr>
                                    }
                    else
                                    {
                                        foreach (var planilla in Model.Planillas)
                                        {
                                            var claseEstado = planilla.Estado switch
                                            {
                                                "CERRADA" => "bemo-status-green",
                                                "CALCULADA" => "bemo-status-yellow",
                                                _ => "bemo-status-yellow"
                                            };
                                            <tr>
                                                <td class="font-bold">#@planilla.NumeroPlanilla</td>
                                                <td>@Fecha(planilla.PeriodoInicio) - @Fecha(planilla.PeriodoFin)</td>
                                                <td>@Fecha(planilla.FechaPago)</td>
                                                <td>@planilla.CantidadEmpleados</td>
                                                <td>@planilla.TotalBruto.ToString("C2")</td>
                                                <td>@planilla.TotalDeducciones.ToString("C2")</td>
                                                <td class="font-bold">@planilla.TotalLiquido.ToString("C2")</td>
                                                <td><span class="bemo-status @claseEstado">@planilla.Estado</span></td>
                                                <td>
                                                    <div class="flex flex-wrap gap-2">
                                                        <a asp-action="Detalle" asp-route-id="@planilla.IdPlanilla"
                                                           class="bemo-button bemo-button-ghost">
                                                            <svg class="bemo-icon-sm" viewBox="0 0 24 24">
                                                                <use href="#icon-eye"></use>
                                                            </svg>
                                                            Ver detalle
                                                        </a>
                                                        @if (planilla.Estado == "BORRADOR")
                                                        {
                                                            <a asp-action="Calcular" asp-route-id="@planilla.IdPlanilla"
                                                               class="bemo-button bemo-button-ghost">Continuar</a>
                                                        }
                                                        else if (planilla.Estado == "CALCULADA")
                                                        {
                                                            <a asp-action="Cerrar" asp-route-id="@planilla.IdPlanilla"
                                                               class="bemo-button bemo-button-primary">Cerrar</a>
                                                            <a asp-action="Reabrir" asp-route-id="@planilla.IdPlanilla"
                                                               class="bemo-button bemo-button-ghost">Reabrir</a>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <nav class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center" aria-label="Paginacion de planillas">
                        <p class="text-sm text-[#684026]">Mostrando @inicio - @fin de @Model.TotalRegistros planillas</p>
                        <div class="flex flex-wrap items-center gap-2">
                            @if (Model.PaginaActual > 1)
                            {
                                <a class="bemo-button bemo-button-secondary" href="@UrlPagina(Model.PaginaActual - 1)">Anterior</a>
                            }
                            @for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                            {
                                <a class="@(pagina == Model.PaginaActual ? "bemo-button bemo-button-primary" : "bemo-button bemo-button-secondary")"
                                   href="@UrlPagina(pagina)">@pagina</a>
                            }
                            @if (Model.PaginaActual < Model.TotalPaginas)
                            {
                                <a class="bemo-button bemo-button-secondary" href="@UrlPagina(Model.PaginaActual + 1)">Siguiente</a>
                            }
                        </div>
                    </nav>
                </div>

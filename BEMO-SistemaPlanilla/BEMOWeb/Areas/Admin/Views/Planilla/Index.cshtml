@{
    ViewData["Title"] = "Planilla";
}

<div class="space-y-6"><header class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start"><div><p class="bemo-kicker">Planilla</p><h1 class="bemo-title mt-2">Planilla</h1><p class="bemo-subtitle mt-2">Procesa y consulta la planilla quincenal.</p></div><span class="bemo-button bemo-button-secondary">Datos de ejemplo</span></header>
    <section class="bemo-card grid gap-4 p-4 lg:grid-cols-[1fr_1fr_1fr_auto] lg:items-end"><div><label class="bemo-label">Período</label><select class="bemo-select"><option>Noviembre 2026</option><option>Octubre 2026</option></select></div><div><label class="bemo-label">Quincena</label><select class="bemo-select"><option>Primera (01–15)</option><option>Segunda (16–30)</option></select></div><div><label class="bemo-label">Estado</label><select class="bemo-select"><option>Borrador</option><option>Revisada</option><option>Cerrada</option></select></div><div class="flex flex-wrap gap-3 border-l-0 border-[#D7C49E] lg:border-l lg:pl-5"><a asp-action="Calcular" class="bemo-button bemo-button-primary"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-calculator"></use></svg>Calcular planilla</a><button class="bemo-button bemo-button-secondary" type="button"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-search"></use></svg>Revisar</button><a asp-action="Cerrar" class="bemo-button bemo-button-ghost"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-lock"></use></svg>Cerrar período</a></div></section>

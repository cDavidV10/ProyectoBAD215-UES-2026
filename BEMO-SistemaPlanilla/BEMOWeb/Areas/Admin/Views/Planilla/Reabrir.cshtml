@using System.Globalization
@model BEMOWeb.Models.ReabrirPlanillaModel

@{
    ViewData["Title"] = "Reabrir planilla";
    string Fecha(DateOnly fecha) => fecha.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);
}

<div class="space-y-5">
    <div>
        <p class="bemo-breadcrumb">Planilla <span class="mx-2">›</span> Reabrir planilla</p>
        <h1 class="bemo-title mt-3">Reabrir planilla #@Model.Planilla.NumeroPlanilla</h1>
        <p class="bemo-subtitle mt-2">La planilla regresara a BORRADOR para corregir asistencia y volver a calcularla.</p>
    </div>

        <form action="@Url.Action("ConfirmarReapertura", "Planilla", new { area = ViewContext.RouteData.Values["area"]?.ToString(), id = Model.IdPlanilla })"
          method="post" class="bemo-card space-y-5 p-5 md:p-8" data-reopen-form novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="IdPlanilla" value="@Model.IdPlanilla" />
        <div asp-validation-summary="ModelOnly" class="bemo-alert bemo-alert-error"></div>
        <div class="grid gap-4 md:grid-cols-3">
            <div><p class="bemo-label">Periodo</p><p class="font-bold">@Fecha(Model.Planilla.PeriodoInicio) - @Fecha(Model.Planilla.PeriodoFin)</p></div>
            <div><p class="bemo-label">Estado actual</p><p class="font-bold">@Model.Planilla.Estado</p></div>
            <div><p class="bemo-label">Neto calculado</p><p class="font-bold">@Model.Planilla.TotalLiquido.ToString("C2")</p></div>
        </div>
        <div>
            <label class="bemo-label bemo-required" asp-for="Motivo">Motivo de la reapertura</label>
            <textarea asp-for="Motivo" class="bemo-textarea" maxlength="100" rows="4"
                      placeholder="Explique por que se reabrira la planilla..."></textarea>
            <p class="bemo-validation-message text-red-700" data-reopen-client-error hidden>
                Indique el motivo de la reapertura.
            </p>
            <span asp-validation-for="Motivo" class="bemo-validation-message"></span>
        </div>
        <div class="bemo-info"><svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-info"></use></svg>La reapertura queda registrada en la auditoria.</div>
        <div class="flex flex-wrap gap-3">
            <button type="submit" class="bemo-button bemo-button-primary" data-reopen-submit>Reabrir planilla</button>
            <a asp-action="Index" class="bemo-button bemo-button-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.querySelector("[data-reopen-form]");
            if (!form) return;

            const motivo = form.querySelector("[name='Motivo']");
            const error = form.querySelector("[data-reopen-client-error]");
            const submit = form.querySelector("[data-reopen-submit]");

            form.addEventListener("submit", (event) => {
                if (!motivo || !motivo.value.trim()) {
                    event.preventDefault();
                    if (error) error.hidden = false;
                    motivo?.focus();
                    return;
                }

                if (submit) {
                    submit.disabled = true;
                    submit.textContent = "Procesando...";
                }
            });

            motivo?.addEventListener("input", () => {
                if (error) error.hidden = motivo.value.trim().length > 0;
            });
        })();
    </script>
}

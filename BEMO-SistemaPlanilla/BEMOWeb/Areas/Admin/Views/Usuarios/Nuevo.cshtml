@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="space-y-5"><div><p class="bemo-breadcrumb">Administración <span class="mx-2">›</span> Usuarios y roles</p><h1 class="bemo-title mt-3">Nuevo usuario</h1></div><form class="bemo-card space-y-5 p-5 md:p-8" data-demo-form><div class="grid gap-5 md:grid-cols-3"><div><label class="bemo-label bemo-required">Empleado</label><div class="relative"><svg class="bemo-icon absolute right-3 top-3" viewBox="0 0 24 24"><use href="#icon-search"></use></svg><input class="bemo-input pr-11" placeholder="Buscar empleado" required /></div></div><div><label class="bemo-label bemo-required">Rol</label><select class="bemo-select" required><option>Seleccionar rol</option><option>ADMINISTRADOR NOMINA</option><option>RECURSOS HUMANOS</option></select></div><div><label class="bemo-label">Nombre de usuario</label><input class="bemo-input" value="Se generará al guardar" disabled /></div><div><label class="bemo-label bemo-required">Contraseña inicial</label><input class="bemo-input" type="password" placeholder="••••••••" required /></div><div><label class="bemo-label bemo-required">Confirmar contraseña</label><input class="bemo-input" type="password" placeholder="••••••••" required /></div><div><label class="bemo-label">Estado</label><select class="bemo-select"><option>Activo</option><option>Inactivo</option></select></div></div><div class="bemo-info"><svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-info"></use></svg>El nombre de usuario se genera automáticamente y no se puede modificar.</div><div class="flex flex-wrap gap-3"><button class="bemo-button bemo-button-primary" type="submit">Crear usuario</button><a asp-area="Admin" asp-controller="Usuarios" asp-action="Index" class="bemo-button bemo-button-secondary">Cancelar</a></div></form></div>

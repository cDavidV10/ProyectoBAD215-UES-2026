@using System
@using System.Collections.Generic
@model BEMOWeb.Models.UsuariosModel

@{
    ViewData["Title"] = "Usuarios y roles";
    var usuarioCreado = TempData["UsuarioCreado"] as string;
    var mensajeNotificacion = TempData["Mensaje"] as string;
    var errorNotificacion = TempData["Error"] as string;
    var inicio = Model.TotalRegistros == 0 ? 0 : ((Model.PaginaActual - 1) * Model.TamanoPagina) + 1;
    var fin = Math.Min(Model.PaginaActual * Model.TamanoPagina, Model.TotalRegistros);

    string UrlPagina(int pagina)
    {
        var parametros = new List<string> { $"pagina={pagina}" };

        if (!string.IsNullOrWhiteSpace(Model.Busqueda))
        {
            parametros.Add($"busqueda={Uri.EscapeDataString(Model.Busqueda)}");
        }

        if (!string.IsNullOrWhiteSpace(Model.RolSeleccionado))
        {
            parametros.Add($"rol={Uri.EscapeDataString(Model.RolSeleccionado)}");
        }

        if (!string.IsNullOrWhiteSpace(Model.EstadoSeleccionado))
        {
            parametros.Add($"estado={Uri.EscapeDataString(Model.EstadoSeleccionado)}");
        }

        return "?" + string.Join("&", parametros);
    }
}

<div class="space-y-5">
    <header class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
        <div>
            <p class="bemo-kicker">Administración</p>
            <h1 class="bemo-title mt-2">Usuarios y roles</h1>
            <p class="bemo-subtitle mt-2">Administra las cuentas y el acceso al sistema.</p>
        </div>
        <a asp-area="Admin" asp-controller="Usuarios" asp-action="Nuevo"
           class="bemo-button bemo-button-primary self-start">
            <svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-user-plus"></use></svg>
            Nuevo usuario
        </a>
    </header>

    @if (!string.IsNullOrWhiteSpace(mensajeNotificacion) || !string.IsNullOrWhiteSpace(errorNotificacion))
    {
        <div class="bemo-notifications" aria-live="polite" aria-atomic="true">
            @if (!string.IsNullOrWhiteSpace(mensajeNotificacion))
            {
                <div class="bemo-notification bemo-notification-success" data-notification data-notification-seconds="5" role="status">
                    <div class="bemo-notification-body">
                        <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-check"></use></svg>
                        <div class="min-w-0 flex-1">
                            <p>@mensajeNotificacion</p>
                            <span class="bemo-notification-countdown" data-notification-countdown></span>
                        </div>
                        <button type="button" class="bemo-notification-close" data-notification-close aria-label="Cerrar notificación">&times;</button>
                    </div>
                    <div class="bemo-notification-progress" data-notification-progress></div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(errorNotificacion))
            {
                <div class="bemo-notification bemo-notification-error" data-notification data-notification-seconds="7" role="alert">
                    <div class="bemo-notification-body">
                        <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-ban"></use></svg>
                        <div class="min-w-0 flex-1">
                            <p>@errorNotificacion</p>
                            <span class="bemo-notification-countdown" data-notification-countdown></span>
                        </div>
                        <button type="button" class="bemo-notification-close" data-notification-close aria-label="Cerrar notificación">&times;</button>
                    </div>
                    <div class="bemo-notification-progress" data-notification-progress></div>
                </div>
            }
        </div>
    }

    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_18rem]">
        <section class="bemo-card p-4">
            <div class="flex border-b border-[#D7C49E]">
                <button class="bemo-tab active" type="button">Usuarios</button>
            </div>

            <form method="get" asp-area="Admin" asp-controller="Usuarios" asp-action="Index"
                  class="mt-5 grid gap-4 md:grid-cols-[1fr_1fr_1fr]">
                <div>
                    <label class="bemo-label" for="busqueda">Buscar usuario</label>
                    <div class="relative">
                        <svg class="bemo-icon absolute left-3 top-3" viewBox="0 0 24 24"><use href="#icon-search"></use></svg>
                        <input id="busqueda" name="busqueda" value="@Model.Busqueda"
                               class="bemo-input pl-11" placeholder="Usuario, nombre o DUI..." />
                    </div>
                </div>
                <div>
                    <label class="bemo-label" for="rol">Rol</label>
                    <select id="rol" name="rol" class="bemo-select" onchange="this.form.submit()">
                        <option value="">Todos los roles</option>
                        @foreach (var rol in Model.Roles)
                        {
                            <option value="@rol" selected="@(string.Equals(rol, Model.RolSeleccionado, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@rol</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="bemo-label" for="estado">Estado</label>
                    <select id="estado" name="estado" class="bemo-select" onchange="this.form.submit()">
                        <option value="">Todos los estados</option>
                        <option value="ACTIVO" selected="@(string.Equals(Model.EstadoSeleccionado, "ACTIVO", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Activo</option>
                        <option value="INACTIVO" selected="@(string.Equals(Model.EstadoSeleccionado, "INACTIVO", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Inactivo</option>
                    </select>
                </div>
            </form>

            <div class="bemo-table-wrap mt-5">
                <table class="bemo-table">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Empleado</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Último acceso</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Usuarios.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="py-8 text-center text-[#684026]">
                                    No hay usuarios que coincidan con los filtros.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var usuario in Model.Usuarios)
                            {
                                var estadoClase = string.Equals(usuario.Estado, "ACTIVO", StringComparison.OrdinalIgnoreCase)
                                    ? "bemo-status-green"
                                    : "bemo-status-red";
                                var estadoTexto = string.Equals(usuario.Estado, "ACTIVO", StringComparison.OrdinalIgnoreCase)
                                    ? "Activo"
                                    : "Inactivo";
                                <tr>
                                    <td class="font-bold">@usuario.NombreUsuario</td>
                                    <td>@usuario.NombreEmpleado</td>
                                    <td>@usuario.NombreRol</td>
                                    <td><span class="bemo-status @estadoClase">@estadoTexto</span></td>
                                    <td>—</td>
                                    <td>
                                        <div class="flex flex-wrap gap-2">
                                            <button type="button" class="bemo-button bemo-button-ghost"
                                                    data-user-password-edit
                                                    data-user-id="@usuario.IdUsuario"
                                                    data-user-name="@usuario.NombreUsuario">
                                                <svg class="bemo-icon-sm" viewBox="0 0 24 24"><use href="#icon-edit"></use></svg>
                                                Editar
                                            </button>
                                        @if (string.Equals(usuario.Estado, "ACTIVO", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form asp-area="Admin" asp-controller="Usuarios" asp-action="Desactivar"
                                                  method="post" class="inline" data-confirm="¿Deseas desactivar este usuario? Ya no podrá iniciar sesión.">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@usuario.IdUsuario" />
                                                <input type="hidden" name="pagina" value="@Model.PaginaActual" />
                                                <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                                <input type="hidden" name="rol" value="@Model.RolSeleccionado" />
                                                <input type="hidden" name="estado" value="@Model.EstadoSeleccionado" />
                                                <button class="bemo-button bemo-button-ghost" type="submit">
                                                    <svg class="bemo-icon-sm" viewBox="0 0 24 24"><use href="#icon-ban"></use></svg>
                                                    Desactivar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-area="Admin" asp-controller="Usuarios" asp-action="Activar"
                                                  method="post" class="inline"
                                                  data-confirm="Â¿Deseas activar este usuario? PodrÃ¡ iniciar sesiÃ³n nuevamente."
                                                  data-confirm-title="Confirmar activaciÃ³n"
                                                  data-confirm-accept-text="Activar usuario">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@usuario.IdUsuario" />
                                                <input type="hidden" name="pagina" value="@Model.PaginaActual" />
                                                <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                                <input type="hidden" name="rol" value="@Model.RolSeleccionado" />
                                                <input type="hidden" name="estado" value="@Model.EstadoSeleccionado" />
                                                <button class="bemo-button bemo-button-ghost" type="submit">
                                                    <svg class="bemo-icon-sm" viewBox="0 0 24 24"><use href="#icon-check"></use></svg>
                                                    Activar
                                                </button>
                                            </form>
                                        }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <nav class="mt-5 flex flex-col justify-between gap-3 sm:flex-row sm:items-center"
                 aria-label="Paginación de usuarios">
                <p class="text-sm text-[#684026]">Mostrando @inicio - @fin de @Model.TotalRegistros usuarios</p>
                <div class="flex flex-wrap items-center gap-2">
                    @if (Model.PaginaActual > 1)
                    {
                        <a class="bemo-button bemo-button-secondary" href="@UrlPagina(Model.PaginaActual - 1)">Anterior</a>
                    }

                    @if (Model.TotalPaginas <= 7)
                    {
                        @for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                        {
                            var clasePagina = pagina == Model.PaginaActual
                                ? "bemo-button bemo-button-primary"
                                : "bemo-button bemo-button-secondary";
                            <a class="@clasePagina" href="@UrlPagina(pagina)">@pagina</a>
                        }
                    }
                    else
                    {
                        <a class="@(Model.PaginaActual == 1 ? "bemo-button bemo-button-primary" : "bemo-button bemo-button-secondary")" href="@UrlPagina(1)">1</a>
                        <span class="flex items-center px-1 text-[#684026]">...</span>
                        var paginaInicio = Math.Max(2, Model.PaginaActual - 1);
                        var paginaFin = Math.Min(Model.TotalPaginas - 1, Model.PaginaActual + 1);
                        @for (var pagina = paginaInicio; pagina <= paginaFin; pagina++)
                        {
                            var clasePagina = pagina == Model.PaginaActual
                                ? "bemo-button bemo-button-primary"
                                : "bemo-button bemo-button-secondary";
                            <a class="@clasePagina" href="@UrlPagina(pagina)">@pagina</a>
                        }
                        <span class="flex items-center px-1 text-[#684026]">...</span>
                        <a class="@(Model.PaginaActual == Model.TotalPaginas ? "bemo-button bemo-button-primary" : "bemo-button bemo-button-secondary")" href="@UrlPagina(Model.TotalPaginas)">@Model.TotalPaginas</a>
                    }

                    @if (Model.PaginaActual < Model.TotalPaginas)
                    {
                        <a class="bemo-button bemo-button-secondary" href="@UrlPagina(Model.PaginaActual + 1)">Siguiente</a>
                    }
                </div>
            </nav>

            <div class="bemo-info mt-5">
                <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-info"></use></svg>
                La baja de cuentas conserva el historial.
            </div>
        </section>

        <aside class="bemo-card h-fit p-5">
            <h2 class="text-xl font-extrabold">Roles disponibles</h2>
            <ul class="mt-5 list-disc space-y-4 pl-5">
                <li><strong>ADMINISTRADOR:</strong> gestión completa.</li>
                <li><strong>RECURSOS HUMANOS:</strong> empleados, préstamos, anticipos y capacitaciones.</li>
            </ul>
        </aside>
    </div>
</div>

<div class="fixed inset-0 z-[70] hidden bg-black/50 p-4" data-user-password-modal aria-hidden="true">
    <section class="relative mx-auto mt-20 w-full max-w-lg rounded-xl bg-white p-6 shadow-2xl"
             role="dialog" aria-modal="true" aria-labelledby="edit-user-password-title">
        <button type="button"
                class="absolute right-4 top-4 rounded-md p-2 text-2xl leading-none text-[#684026] hover:bg-[#F7F0E2]"
                data-user-password-close aria-label="Cerrar modal">&times;</button>
        <div class="pr-8">
            <p class="bemo-kicker">Editar usuario</p>
            <h2 id="edit-user-password-title" class="bemo-title mt-2">Cambiar contrasena</h2>
            <p class="mt-3 text-[#684026]">
                Usuario que se modificara:
                <strong data-user-password-name></strong>
            </p>
        </div>

        <form asp-area="Admin" asp-controller="Usuarios" asp-action="CambiarPassword" method="post"
              class="mt-6 space-y-4" data-user-form data-user-password-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="IdUsuario" data-user-password-id />
            <input type="hidden" name="pagina" value="@Model.PaginaActual" />
            <input type="hidden" name="busqueda" value="@Model.Busqueda" />
            <input type="hidden" name="rol" value="@Model.RolSeleccionado" />
            <input type="hidden" name="estado" value="@Model.EstadoSeleccionado" />

            <div>
                <label class="bemo-label bemo-required" for="UsuarioPasswordNueva">Nueva contrasena</label>
                <div class="relative">
                    <input id="UsuarioPasswordNueva" name="PasswordNueva" type="password"
                           class="bemo-input pr-20" minlength="8" required autocomplete="new-password"
                           data-password-field placeholder="Ingrese la nueva contrasena" />
                    <button type="button" class="absolute right-2 top-1/2 -translate-y-1/2 p-2 text-[#804C2C] hover:text-[#381F12]"
                            data-password-toggle data-password-target="UsuarioPasswordNueva"
                            aria-label="Mostrar contrasena" title="Mostrar contrasena" aria-pressed="false">
                        <svg class="bemo-icon-sm" viewBox="0 0 24 24" data-password-icon><use href="#icon-eye"></use></svg>
                        <span class="sr-only" data-password-label>Mostrar contrasena</span>
                    </button>
                </div>
            </div>

            <div>
                <label class="bemo-label bemo-required" for="UsuarioPasswordConfirmar">Confirmar contrasena</label>
                <div class="relative">
                    <input id="UsuarioPasswordConfirmar" name="ConfirmarPassword" type="password"
                           class="bemo-input pr-20" minlength="8" required autocomplete="new-password"
                           data-password-field data-password-confirmation placeholder="Repita la nueva contrasena" />
                    <button type="button" class="absolute right-2 top-1/2 -translate-y-1/2 p-2 text-[#804C2C] hover:text-[#381F12]"
                            data-password-toggle data-password-target="UsuarioPasswordConfirmar"
                            aria-label="Mostrar contrasena" title="Mostrar contrasena" aria-pressed="false">
                        <svg class="bemo-icon-sm" viewBox="0 0 24 24" data-password-icon><use href="#icon-eye"></use></svg>
                        <span class="sr-only" data-password-label>Mostrar contrasena</span>
                    </button>
                </div>
            </div>

            <div class="bemo-info">
                <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-info"></use></svg>
                La nueva contrasena debe tener minimo 8 caracteres, mayusculas, minusculas, numeros y simbolos.
            </div>

            <div class="flex justify-end gap-3">
                <button type="button" class="bemo-button bemo-button-secondary" data-user-password-close>Cancelar</button>
                <button type="submit" class="bemo-button bemo-button-primary">Guardar cambios</button>
            </div>
        </form>
    </section>
</div>

<div class="fixed inset-0 z-[60] hidden bg-black/50 p-4" data-confirm-modal aria-hidden="true">
    <section class="relative mx-auto mt-20 max-w-lg rounded-xl bg-white p-6 shadow-2xl"
             role="dialog" aria-modal="true" aria-labelledby="confirm-user-title">
        <button type="button"
                class="absolute right-4 top-4 rounded-md p-2 text-2xl leading-none text-[#684026] hover:bg-[#F7F0E2]"
                data-confirm-cancel aria-label="Cerrar confirmación">&times;</button>
        <div class="flex items-start gap-4 pr-8">
            <div class="bemo-stat-icon shrink-0">
                <svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-ban"></use></svg>
            </div>
            <div>
                <h2 id="confirm-user-title" class="text-xl font-extrabold">Confirmar desactivación</h2>
                <p class="mt-2 text-[#684026]" data-confirm-message></p>
            </div>
        </div>
        <div class="mt-6 flex justify-end gap-3">
            <button type="button" class="bemo-button bemo-button-secondary" data-confirm-cancel>Cancelar</button>
            <button type="button" class="bemo-button bemo-button-primary" data-confirm-accept>Desactivar usuario</button>
        </div>
    </section>
</div>

@if (!string.IsNullOrWhiteSpace(usuarioCreado))
{
    <div class="fixed inset-0 z-[60] flex items-center justify-center bg-black/50 p-4"
         data-user-created-modal aria-hidden="false">
        <section class="relative w-full max-w-md rounded-xl bg-white p-6 shadow-2xl"
                 role="dialog" aria-modal="true" aria-labelledby="user-created-title">
            <button type="button"
                    class="absolute right-4 top-4 rounded-md p-2 text-2xl leading-none text-[#684026] hover:bg-[#F7F0E2]"
                    data-user-created-close aria-label="Cerrar confirmación">&times;</button>
            <div class="pr-8">
                <p class="bemo-kicker">Usuario creado</p>
                <h2 id="user-created-title" class="bemo-title mt-2">Registro completado</h2>
                <p class="mt-3 text-[#684026]">El nombre de usuario generado es:</p>
                <p class="mt-2 rounded-lg bg-[#F7F0E2] px-4 py-3 text-center text-xl font-extrabold tracking-wide text-[#9F5F2F]">
                    @usuarioCreado
                </p>
            </div>
            <button type="button" class="bemo-button bemo-button-primary mt-6 w-full" data-user-created-close>
                Aceptar
            </button>
        </section>
    </div>
}

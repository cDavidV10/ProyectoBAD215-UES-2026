@model BEMOWeb.Models.NuevaCapacitacionModel

@{
    ViewData["Title"] = "Nueva capacitación";
    var areaActual = ViewContext.RouteData.Values["area"]?.ToString() ?? "Admin";
}

<div class="space-y-5">
    <div>
        <p class="bemo-breadcrumb">Administración <span class="mx-2">›</span> Capacitaciones</p>
        <h1 class="bemo-title mt-3">Nueva capacitación</h1>
        <p class="bemo-subtitle mt-2">Registra la actividad y después asigna los empleados participantes.</p>
    </div>

    <form asp-area="@areaActual" asp-controller="Capacitaciones" asp-action="Nueva" method="post" class="bemo-card space-y-5 p-5 md:p-8" data-employee-form>
        @Html.AntiForgeryToken()
        <div class="bemo-alert bemo-alert-error" data-client-validation-message role="alert" hidden>
            <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-ban"></use></svg>
            <span>Revisa los campos marcados antes de guardar.</span>
        </div>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bemo-alert bemo-alert-error" role="alert">
                <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-ban"></use></svg>
                <div><strong>Corrige los campos marcados antes de guardar.</strong><div asp-validation-summary="All" class="text-sm"></div></div>
            </div>
        }

        <div class="bemo-section-bar">Información general</div>
        <div class="grid gap-5 md:grid-cols-2">
            <div>
                <label class="bemo-label bemo-required" asp-for="NombreCapacitacion">Nombre de la capacitación</label>
                <input class="bemo-input" asp-for="NombreCapacitacion" placeholder="Ej. Seguridad industrial" maxlength="50" />
                <span asp-validation-for="NombreCapacitacion" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" asp-for="IdTipoCapacitacion">Tipo de capacitación</label>
                <select class="bemo-select" asp-for="IdTipoCapacitacion">
                    <option value="">Seleccione una opción</option>
                    @foreach (var tipo in Model.TiposCapacitacion)
                    {
                        <option value="@tipo.IdTipoCapacitacion">@tipo.NombreTipoCapacitacion</option>
                    }
                </select>
                <span asp-validation-for="IdTipoCapacitacion" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
        </div>

        <div class="bemo-info">
            <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-info"></use></svg>
            <span>Las fechas se registran al asignar participantes, porque cada participación conserva su propio periodo.</span>
        </div>

        <div class="flex flex-wrap gap-3 pt-2">
            <button class="bemo-button bemo-button-primary" type="submit"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-save"></use></svg>Guardar capacitación</button>
            <a asp-area="@areaActual" asp-controller="Capacitaciones" asp-action="Index" class="bemo-button bemo-button-secondary">Cancelar</a>
        </div>
    </form>
</div>

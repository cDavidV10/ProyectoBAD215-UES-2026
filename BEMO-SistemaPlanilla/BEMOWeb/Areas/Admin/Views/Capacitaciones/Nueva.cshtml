@{
    ViewData["Title"] = "Nueva capacitación";
}

<div class="space-y-5"><div><p class="bemo-breadcrumb">Administración <span class="mx-2">›</span> Capacitaciones</p><h1 class="bemo-title mt-3">Nueva capacitación</h1></div><form class="bemo-card space-y-5 p-5 md:p-9" data-demo-form><div class="grid gap-5 md:grid-cols-2"><div><label class="bemo-label bemo-required">Nombre de la capacitación</label><input class="bemo-input" placeholder="Ingrese el nombre" required /></div><div><label class="bemo-label bemo-required">Tipo de capacitación</label><select class="bemo-select" required><option>Seleccione una opción</option><option>Técnica</option><option>Inducción</option></select></div><div><label class="bemo-label bemo-required">Fecha de inicio</label><input class="bemo-input" type="date" required /></div><div><label class="bemo-label">Fecha de finalización</label><input class="bemo-input" type="date" /></div><div class="md:col-span-2"><label class="bemo-label">Descripción</label><textarea class="bemo-textarea min-h-[7rem]" placeholder="Ingrese una descripción"></textarea></div></div><div class="bemo-info"><svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-info"></use></svg><span>Los participantes se asignan después de guardar la capacitación.</span></div><div class="flex flex-wrap gap-3"><button class="bemo-button bemo-button-primary" type="submit">Guardar capacitación</button><a asp-action="Index" class="bemo-button bemo-button-secondary">Cancelar</a></div></form></div>

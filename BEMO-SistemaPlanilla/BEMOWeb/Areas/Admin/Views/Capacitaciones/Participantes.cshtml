@using System
@using System.Collections.Generic
@using System.Linq
@model BEMOWeb.Models.CapacitacionParticipantesModel

@{
    ViewData["Title"] = "Asignar participantes";
    var areaActual = ViewContext.RouteData.Values["area"]?.ToString() ?? "Admin";
    var seleccionados = Model.IdEmpleadosSeleccionados.Count;
    var inicio = Model.TotalRegistros == 0 ? 0 : ((Model.PaginaActual - 1) * Model.TamanoPagina) + 1;
    var fin = Math.Min(Model.PaginaActual * Model.TamanoPagina, Model.TotalRegistros);

    string UrlPagina(int pagina)
    {
        var parametros = new List<string>
        {
            $"id={Model.IdCapacitacion}",
            $"pagina={pagina}"
        };

        if (!string.IsNullOrWhiteSpace(Model.Busqueda))
        {
            parametros.Add($"busqueda={Uri.EscapeDataString(Model.Busqueda)}");
        }

        if (!string.IsNullOrWhiteSpace(Model.DepartamentoSeleccionado))
        {
            parametros.Add($"departamento={Uri.EscapeDataString(Model.DepartamentoSeleccionado)}");
        }

        if (Model.IdEmpleadosSeleccionados.Count > 0)
        {
            parametros.Add($"seleccionados={Uri.EscapeDataString(string.Join(",", Model.IdEmpleadosSeleccionados))}");
        }

        return $"?{string.Join("&", parametros)}";
    }
}

<div class="space-y-5">
    <div>
        <p class="bemo-breadcrumb">Capacitaciones <span class="mx-2">›</span> Asignar participantes</p>
        <h1 class="bemo-title mt-3">Asignar participantes</h1>
        <p class="bemo-subtitle mt-2">Selecciona empleados activos para <strong>@Model.NombreCapacitacion</strong>.</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bemo-alert bemo-alert-error" role="alert">
            <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-ban"></use></svg>
            <div><strong>Corrige los datos antes de guardar.</strong><div asp-validation-summary="All" class="text-sm"></div></div>
        </div>
    }

    <section class="bemo-card p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <p class="bemo-kicker">Capacitación seleccionada</p>
                <h2 class="mt-1 text-xl font-extrabold">@Model.NombreCapacitacion</h2>
                <p class="mt-1 text-sm text-[#684026]">CAP-@Model.IdCapacitacion.ToString("D6")</p>
            </div>
            <a asp-area="@areaActual" asp-controller="Capacitaciones" asp-action="Detalle" asp-route-id="@Model.IdCapacitacion" class="bemo-button bemo-button-secondary">Ver detalle</a>
        </div>

        <form method="get" asp-area="@areaActual" asp-controller="Capacitaciones" asp-action="Participantes" class="mt-5 grid gap-4 border-t border-[#E3D2AE] pt-5 md:grid-cols-[1.4fr_1fr_auto] md:items-end" data-assignment-filter-form>
            <input type="hidden" name="id" value="@Model.IdCapacitacion" />
            <input type="hidden" name="seleccionados" value="@string.Join(",", Model.IdEmpleadosSeleccionados)" />
            <div>
                <label class="bemo-label" for="busqueda">Buscar empleado</label>
                <div class="relative">
                    <button class="absolute left-3 top-2.5 z-10 rounded-md p-1 text-[#381F12]" type="submit" aria-label="Buscar empleado"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-search"></use></svg></button>
                    <input class="bemo-input pl-12" id="busqueda" name="busqueda" type="search" value="@Model.Busqueda" placeholder="Nombre o DUI..." />
                </div>
            </div>
            <div>
                <label class="bemo-label" for="departamento">Departamento</label>
                <select class="bemo-select" id="departamento" name="departamento" onchange="this.form.submit()">
                    <option value="">Todos los departamentos</option>
                    @foreach (var departamento in Model.Departamentos)
                    {
                        <option value="@departamento.NombreDepartamento" selected="@(Model.DepartamentoSeleccionado == departamento.NombreDepartamento ? "selected" : null)">@departamento.NombreDepartamento</option>
                    }
                </select>
            </div>
            <a asp-area="@areaActual" asp-controller="Capacitaciones" asp-action="Participantes" asp-route-id="@Model.IdCapacitacion" asp-route-seleccionados="@string.Join(",", Model.IdEmpleadosSeleccionados)" class="bemo-button bemo-button-secondary" data-assignment-reset>Limpiar</a>
        </form>
    </section>

    <form asp-area="@areaActual" asp-controller="Capacitaciones" asp-action="Participantes" method="post" class="bemo-card space-y-5 p-5 md:p-6" data-employee-form data-assignment-form>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdCapacitacion" />
        <input type="hidden" asp-for="NombreCapacitacion" />
        <input type="hidden" asp-for="PaginaActual" />
        <input type="hidden" asp-for="Busqueda" />
        <input type="hidden" asp-for="DepartamentoSeleccionado" />

        <div class="grid gap-4 md:grid-cols-2">
            <div>
                <label class="bemo-label bemo-required" asp-for="FechaInicio">Fecha de inicio</label>
                <input class="bemo-input" asp-for="FechaInicio" type="date" />
                <span asp-validation-for="FechaInicio" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" asp-for="FechaFin">Fecha de finalización</label>
                <input class="bemo-input" asp-for="FechaFin" type="date" />
                <span asp-validation-for="FechaFin" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-xl font-extrabold">Personal disponible</h2>
                <p class="mt-1 text-sm text-[#684026]">Los empleados ya asignados aparecen bloqueados para evitar duplicados.</p>
            </div>
            <span class="rounded-full bg-[#FFF3D7] px-4 py-2 font-bold" data-selected-count>@seleccionados empleado@(seleccionados == 1 ? "" : "s") seleccionado@(seleccionados == 1 ? "" : "s")</span>
        </div>

        <div class="bemo-table-wrap">
            <table class="bemo-table min-w-[760px]">
                <thead><tr><th class="w-14">Sel.</th><th>Empleado</th><th>DUI</th><th>Departamento</th><th>Estado</th></tr></thead>
                <tbody>
                    @if (Model.Empleados.Count == 0)
                    {
                        <tr><td colspan="5" class="py-8 text-center text-[#684026]">No hay empleados para los filtros seleccionados.</td></tr>
                    }
                    else
                    {
                        foreach (var empleado in Model.Empleados)
                        {
                            <tr class="@(empleado.Asignado ? "bg-[#FBF8F1]" : null)">
                                <td><input class="bemo-check" type="checkbox" name="IdEmpleadosSeleccionados" value="@empleado.IdEmpleado" checked="@(empleado.Asignado || Model.EstaSeleccionado(empleado.IdEmpleado) ? "checked" : null)" disabled="@(empleado.Asignado ? "disabled" : null)" /></td>
                                <td><span class="font-semibold">@empleado.NombreEmpleado</span><small class="block text-[#804C2C]">EMP-@empleado.IdEmpleado.ToString("D6")</small></td>
                                <td>@empleado.Dui</td>
                                <td>@empleado.NombreDepartamento</td>
                                <td>
                                    @if (empleado.Asignado)
                                    {
                                        <span class="bemo-status bemo-status-gray">Ya asignado</span>
                                    }
                                    else
                                    {
                                        <span class="bemo-status bemo-status-green">Disponible</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @foreach (var idEmpleado in Model.IdEmpleadosSeleccionados.Where(id => !Model.Empleados.Any(empleado => empleado.IdEmpleado == id)))
        {
            <input type="hidden" name="IdEmpleadosSeleccionados" value="@idEmpleado" />
        }

        @if (Model.TotalRegistros > 0)
        {
            <nav class="flex flex-col justify-between gap-3 border-t border-[#E3D2AE] pt-4 sm:flex-row sm:items-center" aria-label="Paginación de empleados">
                <p class="text-sm text-[#684026]">Mostrando @inicio - @fin de @Model.TotalRegistros empleados</p>
                <div class="flex flex-wrap items-center gap-2">
                    @if (Model.PaginaActual > 1)
                    {
                        <a class="bemo-button bemo-button-secondary" href="@UrlPagina(Model.PaginaActual - 1)" data-assignment-page>Anterior</a>
                    }

                    @if (Model.TotalPaginas <= 7)
                    {
                        @for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                        {
                            var clasePagina = pagina == Model.PaginaActual ? "bemo-button bemo-button-primary" : "bemo-button bemo-button-secondary";
                            <a class="@clasePagina" href="@UrlPagina(pagina)" data-assignment-page>@pagina</a>
                        }
                    }
                    else
                    {
                        var paginaInicio = Math.Max(2, Model.PaginaActual - 2);
                        var paginaFin = Math.Min(Model.TotalPaginas - 1, Model.PaginaActual + 2);
                        <a class="@(Model.PaginaActual == 1 ? "bemo-button bemo-button-primary" : "bemo-button bemo-button-secondary")" href="@UrlPagina(1)" data-assignment-page>1</a>
                        @if (paginaInicio > 2)
                        {
                            <span class="flex items-center px-1 text-[#684026]">...</span>
                        }
                        @for (var pagina = paginaInicio; pagina <= paginaFin; pagina++)
                        {
                            var clasePagina = pagina == Model.PaginaActual ? "bemo-button bemo-button-primary" : "bemo-button bemo-button-secondary";
                            <a class="@clasePagina" href="@UrlPagina(pagina)" data-assignment-page>@pagina</a>
                        }
                        @if (paginaFin < Model.TotalPaginas - 1)
                        {
                            <span class="flex items-center px-1 text-[#684026]">...</span>
                        }
                        <a class="@(Model.PaginaActual == Model.TotalPaginas ? "bemo-button bemo-button-primary" : "bemo-button bemo-button-secondary")" href="@UrlPagina(Model.TotalPaginas)" data-assignment-page>@Model.TotalPaginas</a>
                    }

                    @if (Model.PaginaActual < Model.TotalPaginas)
                    {
                        <a class="bemo-button bemo-button-secondary" href="@UrlPagina(Model.PaginaActual + 1)" data-assignment-page>Siguiente</a>
                    }
                </div>
            </nav>
        }

        <div class="bemo-info"><svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-info"></use></svg><span>El resultado inicial se registra en 0.00 y puede actualizarse desde el detalle.</span></div>

        <div class="flex flex-wrap justify-end gap-3">
            <a asp-area="@areaActual" asp-controller="Capacitaciones" asp-action="Index" class="bemo-button bemo-button-secondary">Cancelar</a>
            <button class="bemo-button bemo-button-primary" type="submit"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-save"></use></svg>Guardar asignación</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const assignmentForm = document.querySelector("[data-assignment-form]");
        const filterForm = document.querySelector("[data-assignment-filter-form]");

        const collectSelection = () => {
            const ids = new Set();
            assignmentForm?.querySelectorAll("input[name='IdEmpleadosSeleccionados']").forEach((input) => {
                if (input.type === "checkbox") {
                    if (input.checked && !input.disabled) ids.add(input.value);
                } else {
                    ids.add(input.value);
                }
            });
            return [...ids];
        };

        const updateSelectionCount = () => {
            const count = collectSelection().length;
            const element = document.querySelector("[data-selected-count]");
            if (element) element.textContent = `${count} empleado${count === 1 ? "" : "s"} seleccionado${count === 1 ? "" : "s"}`;
        };

        assignmentForm?.querySelectorAll("input[name='IdEmpleadosSeleccionados'][type='checkbox']").forEach((checkbox) => {
            checkbox.addEventListener("change", updateSelectionCount);
        });

        filterForm?.addEventListener("submit", () => {
            const input = filterForm.querySelector("input[name='seleccionados']");
            if (input) input.value = collectSelection().join(",");
        });

        document.querySelectorAll("[data-assignment-page]").forEach((link) => {
            link.addEventListener("click", (event) => {
                event.preventDefault();
                const url = new URL(link.href, window.location.href);
                const ids = collectSelection();
                if (ids.length > 0) url.searchParams.set("seleccionados", ids.join(","));
                else url.searchParams.delete("seleccionados");
                window.location.assign(url.toString());
            });
        });

        document.querySelector("[data-assignment-reset]")?.addEventListener("click", (event) => {
            event.preventDefault();
            const url = new URL(event.currentTarget.href, window.location.href);
            const ids = collectSelection();
            if (ids.length > 0) url.searchParams.set("seleccionados", ids.join(","));
            else url.searchParams.delete("seleccionados");
            window.location.assign(url.toString());
        });

        updateSelectionCount();
    </script>
}

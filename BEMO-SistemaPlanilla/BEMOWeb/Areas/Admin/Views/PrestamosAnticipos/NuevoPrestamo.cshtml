@model BEMOWeb.Models.NuevoPrestamoModel

@{
    ViewData["Title"] = "Nuevo préstamo";
}

<div class="space-y-5">
    <div>
        <p class="bemo-breadcrumb"><a asp-action="Index">Préstamos y anticipos</a> <span class="mx-2">›</span> Nuevo préstamo</p>
        <h1 class="bemo-title mt-3">Nuevo préstamo</h1>
        <p class="bemo-subtitle mt-2">La base de datos valida el monto, el contrato vigente y la capacidad de descuento.</p>
    </div>

    <form method="post" asp-action="NuevoPrestamo" class="bemo-card space-y-5 p-5 md:p-7">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="bemo-alert bemo-alert-error"></div>
        <div class="grid gap-4 rounded-xl border border-[#E3D2AE] bg-[#FBF8F1] p-4 md:grid-cols-3">
            <div><p class="bemo-label">Estado inicial</p><span class="bemo-status bemo-status-yellow">Activo</span></div>
            <div><p class="bemo-label">Plazo</p><strong data-loan-term>—</strong></div>
            <div><p class="bemo-label">Cuota quincenal estimada</p><strong data-loan-fee>—</strong></div>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
            <div class="md:col-span-2">
                <label class="bemo-label bemo-required" asp-for="IdEmpleado">Empleado</label>
                <select class="bemo-select" asp-for="IdEmpleado">
                    <option value="">Seleccione un empleado...</option>
                    @foreach (var empleado in Model.Empleados)
                    {
                        <option value="@empleado.IdEmpleado">@empleado.Apellido, @empleado.Nombre (@empleado.Dui)</option>
                    }
                </select>
                <span asp-validation-for="IdEmpleado" class="bemo-validation-message"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" asp-for="FechaOtorgamiento">Fecha de otorgamiento</label>
                <input class="bemo-input" asp-for="FechaOtorgamiento" />
                <span asp-validation-for="FechaOtorgamiento" class="bemo-validation-message"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" asp-for="Monto">Monto solicitado ($)</label>
                <input class="bemo-input" asp-for="Monto" type="number" min="0.01" max="1200" step="0.01" placeholder="0.00" />
                <span class="mt-1 block text-sm text-[#684026]">Máximo $1,200.00.</span>
                <span asp-validation-for="Monto" class="bemo-validation-message"></span>
            </div>
        </div>

        <div class="rounded-lg border border-[#E3D2AE] bg-[#FBF8F1] p-4 text-sm leading-6">
            <strong>Reglas de plazo:</strong> hasta $300 se divide en 12 cuotas; de $300.01 a $600 en 24; y de $600.01 a $1,200 en 48. La cuota también debe respetar el límite del salario quincenal y el préstamo debe terminar dentro del contrato.
        </div>

        <div class="bemo-divider flex flex-wrap justify-end gap-3 pt-4">
            <a asp-action="Index" class="bemo-button bemo-button-secondary">Cancelar</a>
            <button class="bemo-button bemo-button-primary" type="submit"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-save"></use></svg>Registrar préstamo</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const amount = document.getElementById("Monto");
            const term = document.querySelector("[data-loan-term]");
            const fee = document.querySelector("[data-loan-fee]");

            const update = () => {
                const value = Number(amount?.value || 0);
                let months = 0;
                if (value > 0 && value <= 300) months = 12;
                else if (value <= 600 && value > 300) months = 24;
                else if (value <= 1200 && value > 600) months = 48;
                term.textContent = months ? `${months} cuotas` : "—";
                fee.textContent = months ? `$${(value / months).toFixed(2)}` : "—";
            };

            amount?.addEventListener("input", update);
            update();
        })();
    </script>
}

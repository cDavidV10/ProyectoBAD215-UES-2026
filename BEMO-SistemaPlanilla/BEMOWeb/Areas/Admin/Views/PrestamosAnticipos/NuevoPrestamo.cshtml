@model BEMOWeb.Models.NuevoPrestamoModel

@{
    ViewData["Title"] = "Nueva solicitud de préstamo";
}

<div class="space-y-5">
    <div>
        <p class="bemo-breadcrumb"><a asp-action="Index">Préstamos y anticipos</a> <span class="mx-2">›</span> Nueva solicitud</p>
        <h1 class="bemo-title mt-3">Nueva solicitud de préstamo</h1>
    </div>

    <form method="post" asp-action="NuevoPrestamo" class="bemo-card space-y-6 p-5 md:p-7" data-prestamo-form>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdEmpleado" id="IdEmpleado" />
        <div asp-validation-summary="ModelOnly" class="bemo-alert bemo-alert-error"></div>

        <div class="grid gap-5 rounded-xl border border-[#E3D2AE] bg-[#FBF8F1] p-4 md:grid-cols-[180px_1fr] md:items-center">
            <div>
                <p class="bemo-label">Estado inicial</p>
                <span class="bemo-status bemo-status-yellow">Activo</span>
            </div>
            <div class="border-[#E3D2AE] md:border-l md:pl-6">
                <p class="bemo-label">Ayuda</p>
                <p class="mt-1 leading-6">La cuota se valida con el límite configurado sobre el salario neto y el préstamo debe finalizar dentro del contrato vigente.</p>
            </div>
        </div>

        <div class="grid gap-5 md:grid-cols-3">
            <div class="md:col-span-1" data-prestamo-employee-lookup>
                <label class="bemo-label bemo-required" for="Busqueda">Empleado</label>
                <div class="relative">
                    <svg class="bemo-icon absolute left-3 top-3" viewBox="0 0 24 24"><use href="#icon-search"></use></svg>
                    <input class="bemo-input pl-11" asp-for="Busqueda" id="Busqueda" placeholder="Buscar empleado..." autocomplete="off" data-prestamo-employee-search required />
                    <div class="hidden" data-prestamo-employee-results></div>
                </div>
                <span asp-validation-for="IdEmpleado" class="bemo-validation-message"></span>
                <p class="mt-1 text-xs text-[#684026]" data-prestamo-employee-message>Busca por DUI o nombre y selecciona un empleado.</p>
                <div class="hidden" data-employee-info-legacy>
                    <p class="bemo-label">Información del empleado</p>
                    <div class="mt-3 grid gap-3 text-sm sm:grid-cols-2">
                        <div><span class="text-[#684026]">Nombre</span><strong class="mt-1 block" data-employee-info-name>—</strong></div>
                        <div><span class="text-[#684026]">Cargo</span><strong class="mt-1 block" data-employee-info-cargo>—</strong></div>
                        <div><span class="text-[#684026]">Salario bruto</span><strong class="mt-1 block" data-employee-info-salary>—</strong></div>
                        <div><span class="text-[#684026]">Salario quincenal</span><strong class="mt-1 block" data-employee-info-biweekly>—</strong></div>
                    </div>
                    <div class="mt-3 border-t border-[#E3D2AE] pt-3"><span class="text-[#684026]">Límite máximo de préstamo</span><strong class="mt-1 block text-lg" data-employee-info-limit>—</strong></div>
                </div>
                <div class="hidden" data-prestamo-employee-options>
                    @foreach (var empleado in Model.Empleados)
                    {
                        <span data-prestamo-employee-option
                              data-employee-id="@empleado.IdEmpleado"
                              data-employee-dui="@empleado.Dui"
                              data-employee-name="@empleado.Apellido, @empleado.Nombre"></span>
                    }
                </div>
            </div>

            <div>
                <label class="bemo-label bemo-required" asp-for="FechaOtorgamiento">Fecha de solicitud</label>
                <input class="bemo-input" asp-for="FechaOtorgamiento" />
                <span asp-validation-for="FechaOtorgamiento" class="bemo-validation-message"></span>
            </div>

            <div>
                <label class="bemo-label bemo-required" asp-for="Monto">Monto solicitado ($)</label>
                <input class="bemo-input" asp-for="Monto" type="number" min="0.01" max="1200" step="0.01" placeholder="Ingrese el monto..." />
                <span asp-validation-for="Monto" class="bemo-validation-message"></span>
            </div>

            <div>
                <label class="bemo-label">Número de cuotas</label>
                <input class="bemo-input bg-[#F7F0E2]" data-loan-term value="—" readonly />
            </div>

            <div>
                <label class="bemo-label">Cuota estimada ($)</label>
                <input class="bemo-input bg-[#F7F0E2]" data-loan-fee value="—" readonly />
            </div>

            <div class="rounded-lg border border-[#E3D2AE] bg-[#FBF8F1] p-4 text-sm leading-6 md:self-end">
                <strong>Reglas de plazo:</strong> hasta $300 son 12 cuotas; de $300.01 a $600 son 24; y de $600.01 a $1,200 son 48.
            </div>
        </div>

        <section class="hidden" data-employee-info-legacy>
            <div class="grid gap-5 md:grid-cols-5">
                <div>
                    <p class="bemo-label">Nombre</p>
                    <strong class="mt-1 block" data-employee-info-name>—</strong>
                </div>
                <div>
                    <p class="bemo-label">Cargo</p>
                    <strong class="mt-1 block" data-employee-info-cargo>—</strong>
                </div>
                <div>
                    <p class="bemo-label">Salario bruto</p>
                    <strong class="mt-1 block" data-employee-info-salary>—</strong>
                </div>
                <div>
                    <p class="bemo-label">Salario quincenal</p>
                    <strong class="mt-1 block" data-employee-info-biweekly>—</strong>
                </div>
                <div class="border-[#E3D2AE] md:border-l md:pl-5">
                    <p class="bemo-label">Límite máximo de préstamo</p>
                    <strong class="mt-1 block text-lg" data-employee-info-limit>—</strong>
                </div>
            </div>
        </section>

        <section class="hidden rounded-xl border border-[#E3D2AE] bg-[#FBF8F1] p-5" data-employee-info>
            <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
                <div>
                    <p class="bemo-label">Información del empleado</p>
                    <div class="mt-3 grid gap-3 text-sm sm:grid-cols-2">
                        <div><span class="text-[#684026]">Nombre</span><strong class="mt-1 block" data-employee-info-name>—</strong></div>
                        <div><span class="text-[#684026]">Cargo</span><strong class="mt-1 block" data-employee-info-cargo>—</strong></div>
                        <div><span class="text-[#684026]">Salario bruto</span><strong class="mt-1 block" data-employee-info-salary>—</strong></div>
                        <div><span class="text-[#684026]">Salario quincenal</span><strong class="mt-1 block" data-employee-info-biweekly>—</strong></div>
                    </div>
                </div>
                <div class="border-[#E3D2AE] lg:border-l lg:pl-6">
                    <p class="bemo-label">Estado inicial</p>
                    <span class="bemo-status bemo-status-yellow">Activo</span>
                    <div class="my-4 border-t border-[#E3D2AE]"></div>
                    <p class="bemo-label">Límite máximo de préstamo</p>
                    <strong class="mt-1 block text-xl text-[#381F12]" data-employee-info-limit>—</strong>
                    <p class="mt-4 leading-6">La cuota se valida con el salario neto y el préstamo debe finalizar dentro del contrato vigente.</p>
                </div>
            </div>
        </section>

        <div class="bemo-divider flex flex-wrap justify-end gap-3 pt-4">
            <a asp-action="Index" class="bemo-button bemo-button-secondary">Cancelar</a>
            <button class="bemo-button bemo-button-primary" type="submit"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-save"></use></svg>Guardar solicitud</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const lookup = document.querySelector("[data-prestamo-employee-lookup]");
            const employee = document.getElementById("IdEmpleado");
            const date = document.getElementById("FechaOtorgamiento");
            const amount = document.getElementById("Monto");
            const term = document.querySelector("[data-loan-term]");
            const fee = document.querySelector("[data-loan-fee]");
            const infoEndpoint = "@Url.Action("InformacionEmpleado")";
            const infoPanel = document.querySelector("section[data-employee-info]");
            const infoName = infoPanel?.querySelector("[data-employee-info-name]");
            const infoCargo = infoPanel?.querySelector("[data-employee-info-cargo]");
            const infoSalary = infoPanel?.querySelector("[data-employee-info-salary]");
            const infoBiweekly = infoPanel?.querySelector("[data-employee-info-biweekly]");
            const infoLimit = infoPanel?.querySelector("[data-employee-info-limit]");

            const normalizar = (valor) => (valor || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLocaleLowerCase();
            const moneda = (valor) => `$${Number(valor || 0).toFixed(2)}`;

            const cargarInformacionEmpleado = async () => {
                if (!employee?.value || !date?.value) {
                    infoPanel?.classList.add("hidden");
                    return;
                }

                try {
                    const query = new URLSearchParams({ idEmpleado: employee.value, fecha: date.value });
                    const response = await fetch(`${infoEndpoint}?${query}`);
                    const data = await response.json();
                    if (!data.disponible) {
                        infoPanel?.classList.add("hidden");
                        return;
                    }

                    infoName.textContent = data.nombre;
                    infoCargo.textContent = data.cargo;
                    infoSalary.textContent = moneda(data.salarioBruto);
                    infoBiweekly.textContent = moneda(data.salarioQuincenal);
                    infoLimit.textContent = data.tienePrestamoActivo
                        ? "No disponible: ya tiene un préstamo activo"
                        : moneda(data.maximoPrestamo);
                    infoPanel?.classList.remove("hidden");
                } catch {
                    infoPanel?.classList.add("hidden");
                }
            };

            if (lookup) {
                const input = lookup.querySelector("[data-prestamo-employee-search]");
                const employeeId = employee;
                const options = Array.from(lookup.querySelectorAll("[data-prestamo-employee-option]")).map((option) => ({
                    id: option.dataset.employeeId || "",
                    dui: option.dataset.employeeDui || "",
                    name: option.dataset.employeeName || ""
                }));
                const results = lookup.querySelector("[data-prestamo-employee-results]");
                const message = lookup.querySelector("[data-prestamo-employee-message]");

                const render = () => {
                    const query = normalizar(input.value.trim());
                    const matches = options.filter((option) =>
                        !query || normalizar(option.dui).includes(query) || normalizar(option.name).includes(query));
                    const seleccionado = options.find((option) =>
                        normalizar(option.dui) === query || normalizar(option.name) === query ||
                        normalizar(`${option.name} (${option.dui})`) === query)
                        || (query && matches.length === 1 ? matches[0] : null);

                    if (seleccionado && employeeId.value !== seleccionado.id) {
                        employeeId.value = seleccionado.id;
                        input.setCustomValidity("");
                        message.textContent = "Empleado seleccionado.";
                        cargarInformacionEmpleado();
                    }

                    results.innerHTML = "";
                    matches.slice(0, 8).forEach((option) => {
                        const button = document.createElement("button");
                        button.type = "button";
                        button.className = "block w-full border-b border-[#F0E5D2] px-4 py-2 text-left last:border-0 hover:bg-[#FBF8F1]";
                        const name = document.createElement("span");
                        name.className = "block font-semibold text-[#381F12]";
                        name.textContent = option.name;
                        const dui = document.createElement("small");
                        dui.className = "text-[#684026]";
                        dui.textContent = option.dui;
                        button.append(name, dui);
                        button.addEventListener("click", () => {
                            input.value = `${option.name} (${option.dui})`;
                            employeeId.value = option.id;
                            input.setCustomValidity("");
                            results.classList.add("hidden");
                            message.textContent = "Empleado seleccionado.";
                            cargarInformacionEmpleado();
                        });
                        results.appendChild(button);
                    });

                    results.classList.add("hidden");
                    if (query && matches.length === 0) message.textContent = "No se encontró un empleado activo con esa búsqueda.";
                    else if (!employeeId.value) message.textContent = "Busca por DUI o nombre y selecciona un empleado.";
                };

                input.addEventListener("input", () => {
                    employeeId.value = "";
                    input.setCustomValidity("Selecciona un empleado de la lista.");
                    render();
                    cargarInformacionEmpleado();
                });
                input.addEventListener("focus", render);
                input.addEventListener("blur", () => setTimeout(() => results.classList.add("hidden"), 150));
                render();
            }

            const update = () => {
                const value = Number(amount?.value || 0);
                let months = 0;
                if (value > 0 && value <= 300) months = 12;
                else if (value > 300 && value <= 600) months = 24;
                else if (value > 600 && value <= 1200) months = 48;
                term.value = months ? `${months} cuotas` : "—";
                fee.value = months ? (value / months).toFixed(2) : "—";
            };

            amount?.addEventListener("input", update);
            date?.addEventListener("change", cargarInformacionEmpleado);
            update();
            cargarInformacionEmpleado();
        })();
    </script>
}

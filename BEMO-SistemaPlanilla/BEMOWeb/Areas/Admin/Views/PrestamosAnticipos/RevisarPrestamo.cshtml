@model BEMO.Entidades.PrestamoListado

@{
    ViewData["Title"] = "Detalle de préstamo";
    var esActivo = Model.Estado == "ACTIVO";
    var estado = esActivo ? "Activo" : "Pagado";
    var estadoClase = esActivo ? "bemo-status-yellow" : "bemo-status-green";
}

<div class="space-y-5">
    <div>
        <p class="bemo-breadcrumb"><a asp-action="Index">Préstamos y anticipos</a> <span class="mx-2">›</span> Detalle de préstamo</p>
        <h1 class="bemo-title mt-3">Detalle de préstamo PRE-@Model.IdPrestamo.ToString("D6")</h1>
    </div>

    <section class="bemo-card space-y-5 p-5 md:p-7">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#E3D2AE] pb-4">
            <div><p class="bemo-label">Empleado</p><h2 class="text-xl font-extrabold">@Model.NombreEmpleado</h2><p class="text-sm text-[#684026]">DUI: @Model.Dui</p></div>
            <span class="bemo-status @estadoClase">@estado</span>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
            <div><p class="bemo-label">Fecha de otorgamiento</p><p class="font-bold">@Model.FechaOtorgamiento.ToString("dd/MM/yyyy")</p></div>
            <div><p class="bemo-label">Monto original</p><p class="font-bold">@Model.Monto.ToString("C2")</p></div>
            <div><p class="bemo-label">Saldo pendiente</p><p class="font-bold">@Model.SaldoPendiente.ToString("C2")</p></div>
            <div><p class="bemo-label">Número de cuotas</p><p class="font-bold">@Model.NumCuotas</p></div>
            <div><p class="bemo-label">Cuota quincenal</p><p class="font-bold">@Model.CuotaQuincenal.ToString("C2")</p></div>
            <div><p class="bemo-label">Cuotas restantes</p><p class="font-bold">@(esActivo ? Model.CuotasRestantes : 0)</p></div>
        </div>

        @if (Model.FechaFinalizacion.HasValue)
        {
            <div class="rounded-lg border border-[#E3D2AE] bg-[#FBF8F1] p-4"><span class="bemo-label">Fecha de finalización</span><strong>@Model.FechaFinalizacion.Value.ToString("dd/MM/yyyy")</strong></div>
        }
        else
        {
            <div class="rounded-lg border border-[#E3D2AE] bg-[#FBF8F1] p-4 text-sm leading-6">El saldo se actualiza automáticamente cuando se cierra una planilla con una cuota de este préstamo.</div>
        }

        <div class="bemo-divider flex flex-wrap justify-end gap-3 pt-4">
            <a asp-action="Index" class="bemo-button bemo-button-secondary">Volver al listado</a>
        </div>
    </section>
</div>

@model BEMOWeb.Models.PrestamosAnticiposIndexModel

@{
    ViewData["Title"] = "Préstamos y anticipos";
    var esPrestamo = Model.TipoSeleccionado == "prestamos";
    var mensaje = TempData["Mensaje"] as string;
    var error = TempData["Error"] as string;
    string EtiquetaEstado(string estado) => estado switch
    {
        "ACTIVO" => "Activo",
        "PAGADO" => "Pagado",
        "PENDIENTE" => "Pendiente de descuento",
        "DESCONTADO" => "Descontado",
        _ => estado
    };
    string ClaseEstado(string estado) => estado switch
    {
        "ACTIVO" or "PENDIENTE" => "bemo-status-yellow",
        "PAGADO" or "DESCONTADO" => "bemo-status-green",
        _ => "bemo-status-gray"
    };
    var inicio = Model.TotalRegistros == 0 ? 0 : ((Model.PaginaActual - 1) * Model.TamanoPagina) + 1;
    var fin = Math.Min(Model.PaginaActual * Model.TamanoPagina, Model.TotalRegistros);
    string UrlPagina(int pagina) => Url.Action("Index", new
    {
        pagina,
        tipo = Model.TipoSeleccionado,
        busqueda = Model.Busqueda,
        estado = Model.EstadoSeleccionado
    }) ?? "#";
}

<div class="space-y-5">
    <header class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
        <div>
            <p class="bemo-kicker">Administración</p>
            <h1 class="bemo-title mt-2">Préstamos y anticipos</h1>
            <p class="bemo-subtitle mt-2">Registra solicitudes y consulta los descuentos aplicados por planilla.</p>
        </div>
        <div class="flex flex-wrap gap-3 self-start">
            <a asp-action="NuevoAnticipo" class="bemo-button bemo-button-secondary">
                <svg class="bemo-icon" viewBox="0 0 24 24">
                    <use href="#icon-plus"></use>
                </svg>
                Nuevo anticipo
            </a>
            <a asp-action="NuevoPrestamo" class="bemo-button bemo-button-primary">
                <svg class="bemo-icon" viewBox="0 0 24 24">
                    <use href="#icon-plus"></use>
                </svg>
                Nuevo préstamo
            </a>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(mensaje) || !string.IsNullOrWhiteSpace(error))
    {
        <div class="bemo-notifications" aria-live="polite" aria-atomic="true">
            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="bemo-notification bemo-notification-success" data-notification data-notification-seconds="5" role="status">
                    <div class="bemo-notification-body">
                        <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-check"></use></svg>
                        <div class="min-w-0 flex-1">
                            <p>@mensaje</p>
                            <span class="bemo-notification-countdown" data-notification-countdown></span>
                        </div>
                        <button type="button" class="bemo-notification-close" data-notification-close aria-label="Cerrar notificación">&times;</button>
                    </div>
                    <div class="bemo-notification-progress" data-notification-progress></div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="bemo-notification bemo-notification-error" data-notification data-notification-seconds="7" role="alert">
                    <div class="bemo-notification-body">
                        <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-ban"></use></svg>
                        <div class="min-w-0 flex-1">
                            <p>@error</p>
                            <span class="bemo-notification-countdown" data-notification-countdown></span>
                        </div>
                        <button type="button" class="bemo-notification-close" data-notification-close aria-label="Cerrar notificación">&times;</button>
                    </div>
                    <div class="bemo-notification-progress" data-notification-progress></div>
                </div>
            }
        </div>
    }

    <div class="flex gap-6 border-b border-[#D7C49E]">
        <a asp-action="Index" asp-route-tipo="prestamos" asp-route-pagina="1" asp-route-busqueda="@Model.Busqueda"
           class="bemo-tab @(esPrestamo ? "active" : "")">Préstamos</a>
        <a asp-action="Index" asp-route-tipo="anticipos" asp-route-pagina="1" asp-route-busqueda="@Model.Busqueda"
           class="bemo-tab @(!esPrestamo ? "active" : "")">Anticipos de salario</a>
    </div>

    @if (esPrestamo)
    {
        <section class="grid gap-4 lg:grid-cols-3">
            <div class="bemo-stat">
                <div class="bemo-stat-icon"><svg class="bemo-icon" viewBox="0 0 24 24">
                    <use href="#icon-calendar"></use>
                </svg></div>
                <div>
                    <p class="bemo-stat-label">Préstamos activos</p>
                    <p class="bemo-stat-value">@Model.Resumen.PrestamosActivos</p>
                </div>
            </div>
            <div class="bemo-stat">
                <div class="bemo-stat-icon"><svg class="bemo-icon" viewBox="0 0 24 24">
                    <use href="#icon-check"></use>
                </svg></div>
                <div>
                    <p class="bemo-stat-label">Préstamos pagados</p>
                    <p class="bemo-stat-value">@Model.Resumen.PrestamosPagados</p>
                </div>
            </div>
            <div class="bemo-stat">
                <div class="bemo-stat-icon"><svg class="bemo-icon" viewBox="0 0 24 24">
                    <use href="#icon-coins"></use>
                </svg></div>
                <div>
                    <p class="bemo-stat-label">Saldo pendiente</p>
                    <p class="bemo-stat-value">@Model.Resumen.SaldoPrestamos.ToString("C2")</p>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="grid gap-4 lg:grid-cols-3">
            <div class="bemo-stat">
                <div class="bemo-stat-icon"><svg class="bemo-icon" viewBox="0 0 24 24">
                    <use href="#icon-calendar"></use>
                </svg></div>
                <div>
                    <p class="bemo-stat-label">Pendientes de descuento</p>
                    <p class="bemo-stat-value">@Model.Resumen.AnticiposPendientes</p>
                </div>
            </div>
            <div class="bemo-stat">
                <div class="bemo-stat-icon"><svg class="bemo-icon" viewBox="0 0 24 24">
                    <use href="#icon-check"></use>
                </svg></div>
                <div>
                    <p class="bemo-stat-label">Anticipos descontados</p>
                    <p class="bemo-stat-value">@Model.Resumen.AnticiposDescontados</p>
                </div>
            </div>
            <div class="bemo-stat">
                <div class="bemo-stat-icon"><svg class="bemo-icon" viewBox="0 0 24 24">
                    <use href="#icon-coins"></use>
                </svg></div>
                <div>
                    <p class="bemo-stat-label">Monto pendiente</p>
                    <p class="bemo-stat-value">@Model.Resumen.MontoAnticiposPendientes.ToString("C2")</p>
                </div>
            </div>
        </section>
    }

    <form method="get" asp-action="Index" class="bemo-card grid gap-4 p-4 md:grid-cols-[1fr_1fr_auto] md:items-end"
          data-server-search>
        <input type="hidden" name="tipo" value="@Model.TipoSeleccionado" />
        <div>
            <label class="bemo-label" for="busqueda">Empleado</label>
            <div class="relative">
                <button class="absolute left-3 top-2.5 z-10 rounded-md p-1 text-[#381F12]" type="submit"
                        aria-label="Buscar empleado">
                    <svg class="bemo-icon" viewBox="0 0 24 24">
                        <use href="#icon-search"></use>
                    </svg>
                </button>
                <input class="bemo-input pl-12" id="busqueda" type="search" name="busqueda" value="@Model.Busqueda"
                       placeholder="Buscar por DUI o nombre..." autocomplete="off" />
            </div>
        </div>
        <div>
            <label class="bemo-label" for="estado">Estado</label>
            <select class="bemo-select" id="estado" name="estado" onchange="this.form.submit()">
                <option value="">Todos los estados</option>
                @if (esPrestamo)
                {
                    <option value="ACTIVO" selected="@(Model.EstadoSeleccionado == "ACTIVO" ? "selected" : null)">Activo
                    </option>
                    <option value="PAGADO" selected="@(Model.EstadoSeleccionado == "PAGADO" ? "selected" : null)">Pagado
                    </option>
                }
                else
                {
                    <option value="PENDIENTE" selected="@(Model.EstadoSeleccionado == "PENDIENTE" ? "selected" : null)">
                        Pendiente de descuento</option>
                        <option value="DESCONTADO" selected="@(Model.EstadoSeleccionado == "DESCONTADO" ? "selected" : null)">
                            Descontado</option>
                        }
                    </select>
                </div>
            </form>

            @if (esPrestamo)
            {
                <section class="bemo-card overflow-hidden">
                    <div class="bemo-table-wrap">
                        <table class="bemo-table min-w-[980px]">
                            <thead>
                                <tr>
                                    <th>Préstamo</th>
                                    <th>Empleado</th>
                                    <th>Otorgamiento</th>
                                    <th>Monto</th>
                                    <th>Cuota</th>
                                    <th>Cuotas restantes</th>
                                    <th>Saldo</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Prestamos.Count == 0)
                                {
                                    <tr>
                                        <td colspan="9" class="py-8 text-center text-[#684026]">No hay préstamos para los filtros
                                            seleccionados.</td>
                                        </tr>
                                    }
                    else
                                    {
                                        foreach (var prestamo in Model.Prestamos)
                                        {
                                            <tr>
                                                <td>PRE-@prestamo.IdPrestamo.ToString("D6")</td>
                                                <td>@prestamo.NombreEmpleado<br /><small>@prestamo.Dui</small></td>
                                                <td>@prestamo.FechaOtorgamiento.ToString("dd/MM/yyyy")</td>
                                                <td>@prestamo.Monto.ToString("C2")</td>
                                                <td>@prestamo.CuotaQuincenal.ToString("C2")</td>
                                                <td>@(prestamo.Estado == "ACTIVO" ? prestamo.CuotasRestantes : 0)</td>
                                                <td>@prestamo.SaldoPendiente.ToString("C2")</td>
                                                <td><span
                                                    class="bemo-status @ClaseEstado(prestamo.Estado)">@EtiquetaEstado(prestamo.Estado)</span>
                                                </td>
                                                <td><a asp-action="RevisarPrestamo" asp-route-id="@prestamo.IdPrestamo"
                                                       class="bemo-button bemo-button-ghost"><svg class="bemo-icon-sm" viewBox="0 0 24 24">
                                                    <use href="#icon-eye"></use>
                                                </svg>Detalle</a></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
    else
                {
                    <section class="bemo-card overflow-hidden">
                        <div class="bemo-table-wrap">
                            <table class="bemo-table min-w-[800px]">
                                <thead>
                                    <tr>
                                        <th>Anticipo</th>
                                        <th>Empleado</th>
                                        <th>Fecha</th>
                                        <th>Monto</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Anticipos.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="6" class="py-8 text-center text-[#684026]">No hay anticipos para los filtros
                                                seleccionados.</td>
                                            </tr>
                                        }
                    else
                                        {
                                            foreach (var anticipo in Model.Anticipos)
                                            {
                                                <tr>
                                                    <td>ANT-@anticipo.IdAnticipo.ToString("D6")</td>
                                                    <td>@anticipo.NombreEmpleado<br /><small>@anticipo.Dui</small></td>
                                                    <td>@anticipo.FechaAnticipo.ToString("dd/MM/yyyy")</td>
                                                    <td>@anticipo.MontoAnticipo.ToString("C2")</td>
                                                    <td><span
                                                        class="bemo-status @ClaseEstado(anticipo.Estado)">@EtiquetaEstado(anticipo.Estado)</span>
                                                    </td>
                                                    <td><a asp-action="DetalleAnticipo" asp-route-id="@anticipo.IdAnticipo"
                                                           class="bemo-button bemo-button-ghost"><svg class="bemo-icon-sm" viewBox="0 0 24 24">
                                                        <use href="#icon-eye"></use>
                                                    </svg>Detalle</a></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    }

                    <nav class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center"
                         aria-label="Paginación de préstamos y anticipos">
                        <p class="text-sm text-[#684026]">Mostrando @inicio - @fin de @Model.TotalRegistros registros</p>
                        <div class="flex flex-wrap items-center gap-2">
                            @if (Model.PaginaActual > 1)
                            {
                                <a class="bemo-button bemo-button-secondary" href="@UrlPagina(Model.PaginaActual - 1)">Anterior</a>
                            }

                            @if (Model.TotalPaginas <= 7)
                            {
                                @for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                                {
                                    var clasePagina = pagina == Model.PaginaActual ? "bemo-button bemo-button-primary" : "bemo-button bemo-button-secondary";
                                    <a class="@clasePagina" href="@UrlPagina(pagina)">@pagina</a>
                                }
                            }
                            else
                            {
                                var paginaInicio = Math.Max(2, Model.PaginaActual - 2);
                                var paginaFin = Math.Min(Model.TotalPaginas - 1, Model.PaginaActual + 2);
                                var clasePrimera = Model.PaginaActual == 1 ? "bemo-button bemo-button-primary" : "bemo-button bemo-button-secondary";
                                var claseUltima = Model.PaginaActual == Model.TotalPaginas ? "bemo-button bemo-button-primary" :
                    "bemo-button bemo-button-secondary";

                                <a class="@clasePrimera" href="@UrlPagina(1)">1</a>
                                @if (paginaInicio > 2)
                                {
                                    <span class="flex items-center px-1 text-[#684026]">...</span>
                                }
                                @for (var pagina = paginaInicio; pagina <= paginaFin; pagina++)
                                {
                                    var clasePagina = pagina == Model.PaginaActual ? "bemo-button bemo-button-primary" : "bemo-button bemo-button-secondary";
                                    <a class="@clasePagina" href="@UrlPagina(pagina)">@pagina</a>
                                }
                                @if (paginaFin < Model.TotalPaginas - 1)
                                {
                                    <span class="flex items-center px-1 text-[#684026]">...</span>
                                }
                                <a class="@claseUltima" href="@UrlPagina(Model.TotalPaginas)">@Model.TotalPaginas</a>
                            }

                            @if (Model.PaginaActual < Model.TotalPaginas)
                            {
                                <a class="bemo-button bemo-button-secondary" href="@UrlPagina(Model.PaginaActual + 1)">Siguiente</a>
                            }
                        </div>
                    </nav>

                    <section class="bemo-card p-5">
                        <h2 class="text-lg font-extrabold">Aplicación en planilla</h2>
                        <p class="mt-2 leading-7">Al calcular una planilla se agregan los descuentos de los préstamos y anticipos
                            elegibles. Al cerrar la planilla se actualiza el saldo del préstamo y el anticipo pasa a DESCONTADO.</p>
                        </section>
                    </div>

@{
    ViewData["Title"] = "Préstamos y anticipos";
}

<div class="space-y-5">
    <header class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end"><div><p class="bemo-kicker">Administración</p><h1 class="bemo-title mt-2">Préstamos y anticipos</h1><p class="bemo-subtitle mt-2">Administra solicitudes y descuentos del personal.</p></div><div class="flex flex-wrap gap-3 self-start"><a asp-action="NuevoAnticipo" class="bemo-button bemo-button-secondary"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-plus"></use></svg>Nuevo anticipo</a><a asp-action="NuevoPrestamo" class="bemo-button bemo-button-primary"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-plus"></use></svg>Nueva solicitud</a></div></header>
    <div class="flex border-b border-[#D7C49E]"><button class="bemo-tab active" type="button" data-tab="loans">Préstamos</button><button class="bemo-tab" type="button" data-tab="advances">Anticipos de salario</button></div>
    <section class="grid gap-4 lg:grid-cols-3"><div class="bemo-stat"><div class="bemo-stat-icon"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-calendar"></use></svg></div><div><p class="bemo-stat-label">Pendientes</p><p class="bemo-stat-value">6</p></div></div><div class="bemo-stat"><div class="bemo-stat-icon"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-check"></use></svg></div><div><p class="bemo-stat-label">Aprobados</p><p class="bemo-stat-value">18</p></div></div><div class="bemo-stat"><div class="bemo-stat-icon"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-coins"></use></svg></div><div><p class="bemo-stat-label">Saldo pendiente</p><p class="bemo-stat-value">$8,450.00</p></div></div></section>
    <section class="grid gap-4 md:grid-cols-2"><div><label class="bemo-label">Empleado</label><select class="bemo-select"><option>Todos los empleados</option><option>Ana María López</option><option>Carlos Ernesto García</option></select></div><div><label class="bemo-label">Estado</label><select class="bemo-select"><option>Todos los estados</option><option>Pendiente</option><option>Aprobado</option><option>Finalizado</option></select></div></section>
    <section class="bemo-card overflow-hidden"><div class="bemo-table-wrap"><table class="bemo-table"><thead><tr><th>Solicitud</th><th>Empleado</th><th>Monto</th><th>Cuota</th><th>Saldo</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
        <tr><td>PRE-000118</td><td>Ana María López</td><td>$2,000.00</td><td>$200.00</td><td>$1,600.00</td><td><span class="bemo-status bemo-status-yellow">Pendiente</span></td><td><button class="bemo-button bemo-button-ghost" type="button"><svg class="bemo-icon-sm" viewBox="0 0 24 24"><use href="#icon-eye"></use></svg>Ver</button> <a asp-action="RevisarPrestamo" class="bemo-button bemo-button-ghost"><svg class="bemo-icon-sm" viewBox="0 0 24 24"><use href="#icon-document"></use></svg>Revisar</a></td></tr>
        <tr><td>PRE-000117</td><td>Carlos Ernesto García</td><td>$5,000.00</td><td>$500.00</td><td>$3,500.00</td><td><span class="bemo-status bemo-status-green">Aprobado</span></td><td><button class="bemo-button bemo-button-ghost" type="button"><svg class="bemo-icon-sm" viewBox="0 0 24 24"><use href="#icon-eye"></use></svg>Ver detalle</button></td></tr>
        <tr><td>PRE-000116</td><td>Laura Beatriz Martínez</td><td>$1,200.00</td><td>$200.00</td><td>$0.00</td><td><span class="bemo-status bemo-status-gray">Finalizado</span></td><td><button class="bemo-button bemo-button-ghost" type="button"><svg class="bemo-icon-sm" viewBox="0 0 24 24"><use href="#icon-eye"></use></svg>Ver detalle</button></td></tr>
    </tbody></table></div></section>
    <section class="bemo-card flex flex-wrap items-center gap-4 p-4"><strong>Flujo de aprobación:</strong><div class="flex flex-wrap items-center gap-3 text-sm"><span class="bemo-button bemo-button-ghost"><svg class="bemo-icon-sm" viewBox="0 0 24 24"><use href="#icon-document"></use></svg>Solicitud</span><span class="text-2xl">→</span><span class="bemo-button bemo-button-ghost"><svg class="bemo-icon-sm" viewBox="0 0 24 24"><use href="#icon-search"></use></svg>Revisión</span><span class="text-2xl">→</span><span class="bemo-button bemo-button-ghost"><svg class="bemo-icon-sm" viewBox="0 0 24 24"><use href="#icon-check"></use></svg>Aprobación</span><span class="text-2xl">→</span><span class="bemo-button bemo-button-ghost"><svg class="bemo-icon-sm" viewBox="0 0 24 24"><use href="#icon-calendar"></use></svg>Descuento en planilla</span></div></section>
</div>

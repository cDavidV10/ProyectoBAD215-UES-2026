@model BEMOWeb.Models.NuevoAnticipoModel

@{
    ViewData["Title"] = "Nuevo anticipo";
}

<div class="space-y-5">
    <div>
        <p class="bemo-breadcrumb"><a asp-action="Index" asp-route-tipo="anticipos">Préstamos y anticipos</a> <span
            class="mx-2">›</span> Nuevo anticipo</p>
            <h1 class="bemo-title mt-3">Nuevo anticipo de salario</h1>
            <p class="bemo-subtitle mt-2">El monto queda pendiente y se descuenta automáticamente al cerrar la planilla
                correspondiente.</p>
            </div>

            <form method="post" asp-action="NuevoAnticipo" class="bemo-card space-y-5 p-5 md:p-7">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="bemo-alert bemo-alert-error"></div>
                <div class="grid gap-4 rounded-xl border border-[#E3D2AE] bg-[#FBF8F1] p-4 md:grid-cols-3">
                    <div>
                        <p class="bemo-label">Estado inicial</p><span class="bemo-status bemo-status-yellow">Pendiente de
                        descuento</span>
                    </div>
                    <div>
                        <p class="bemo-label">Límite calculado</p><strong data-advance-limit>@(Model.MaximoPermitido.HasValue?
                                        Model.MaximoPermitido.Value.ToString("C2") : "Seleccione empleado")</strong>
                    </div>
                </div>

                <div class="grid gap-4 md:grid-cols-3">
                    <div class="md:col-span-2">
                        <label class="bemo-label bemo-required" asp-for="IdEmpleado">Empleado</label>
                        <select class="bemo-select" asp-for="IdEmpleado">
                            <option value="">Seleccione un empleado...</option>
                            @foreach (var empleado in Model.Empleados)
                            {
                                <option value="@empleado.IdEmpleado">@empleado.Apellido, @empleado.Nombre (@empleado.Dui)</option>
                            }
                        </select>
                        <span asp-validation-for="IdEmpleado" class="bemo-validation-message"></span>
                    </div>
                    <div>
                        <label class="bemo-label bemo-required" asp-for="FechaAnticipo">Fecha del anticipo</label>
                        <input class="bemo-input" asp-for="FechaAnticipo" />
                        <span asp-validation-for="FechaAnticipo" class="bemo-validation-message"></span>
                    </div>
                    <div>
                        <label class="bemo-label bemo-required" asp-for="Monto">Monto solicitado ($)</label>
                        <input class="bemo-input" asp-for="Monto" type="number" min="0.01" step="0.01" placeholder="0.00" />
                        <span asp-validation-for="Monto" class="bemo-validation-message"></span>
                    </div>
                </div>

                <div class="rounded-lg border border-[#E3D2AE] bg-[#FBF8F1] p-4 text-sm leading-6">
                    El máximo se calcula con el 30% del salario quincenal, el límite combinado de descuentos del 35% y la
                    protección de un líquido mínimo del 50%. Solo puede existir un anticipo pendiente por empleado.
                </div>

                <div class="bemo-divider flex flex-wrap justify-end gap-3 pt-4">
                    <a asp-action="Index" asp-route-tipo="anticipos" class="bemo-button bemo-button-secondary">Cancelar</a>
                    <button class="bemo-button bemo-button-primary" type="submit"><svg class="bemo-icon" viewBox="0 0 24 24">
                        <use href="#icon-save"></use>
                    </svg>Registrar anticipo</button>
                </div>
            </form>
        </div>

        @section Scripts {
            <partial name="_ValidationScriptsPartial" />
            <script>
                (() => {
                    const employee = document.getElementById("IdEmpleado");
                    const date = document.getElementById("FechaAnticipo");
                    const amount = document.getElementById("Monto");
                    const limit = document.querySelector("[data-advance-limit]");
                    const endpoint = "@Url.Action("MaximoAnticipo")";

                    const updateLimit = async () => {
                        if (!employee?.value || !date?.value) {
                            limit.textContent = "Seleccione empleado";
                            amount.removeAttribute("max");
                            return;
                        }

                        limit.textContent = "Calculando...";
                        try {
                            const query = new URLSearchParams({ idEmpleado: employee.value, fecha: date.value });
                            const response = await fetch(`${endpoint}?${query}`);
                            const data = await response.json();
                            if (data.maximo === null || data.maximo === undefined) {
                                limit.textContent = "No disponible";
                                amount.removeAttribute("max");
                                return;
                            }

                            const maximo = Number(data.maximo);
                            limit.textContent = `$${maximo.toFixed(2)}`;
                            amount.max = maximo.toFixed(2);
                        } catch {
                            limit.textContent = "Consulte al guardar";
                            amount.removeAttribute("max");
                        }
                    };

                    employee?.addEventListener("change", updateLimit);
                    date?.addEventListener("change", updateLimit);
                    updateLimit();
                })();
            </script>
        }

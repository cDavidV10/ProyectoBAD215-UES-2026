@using System
@using System.Linq
@model BEMOWeb.Models.EmpleadoModel

@{
    ViewData["Title"] = "Empleados";
    var areaActual = ViewContext.RouteData.Values["area"]?.ToString() ?? "Admin";
    var inicio = Model.TotalRegistros == 0 ? 0 : ((Model.PaginaActual - 1) * Model.TamanoPagina) + 1;
    var fin = Math.Min(Model.PaginaActual * Model.TamanoPagina, Model.TotalRegistros);

    string UrlPagina(int pagina)
    {
        var parametros = new List<string> { $"pagina={pagina}" };

        if (!string.IsNullOrWhiteSpace(Model.Busqueda))
        {
            parametros.Add($"busqueda={Uri.EscapeDataString(Model.Busqueda)}");
        }

        if (!string.IsNullOrWhiteSpace(Model.DepartamentoSeleccionado))
        {
            parametros.Add($"departamento={Uri.EscapeDataString(Model.DepartamentoSeleccionado)}");
        }

        if (!string.IsNullOrWhiteSpace(Model.EstadoSeleccionado))
        {
            parametros.Add($"estado={Uri.EscapeDataString(Model.EstadoSeleccionado)}");
        }

        return "?" + string.Join("&", parametros);
    }
}

<div class="space-y-6">
    <header class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
        <div>
            <p class="bemo-kicker">Administración</p>
            <h1 class="bemo-title mt-2">Empleados</h1>
            <p class="bemo-subtitle mt-2">Administra la información del personal.</p>
        </div>
        <a asp-area="@areaActual" asp-controller="Empleados" asp-action="Nuevo"
           class="bemo-button bemo-button-primary self-start">
            <svg class="bemo-icon" viewBox="0 0 24 24">
                <use href="#icon-plus"></use>
            </svg>
            Nuevo empleado
        </a>
    </header>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="bemo-notifications" aria-live="polite" aria-atomic="true">
            <div class="bemo-notification bemo-notification-success" data-notification data-notification-seconds="5" role="status">
                <div class="bemo-notification-body">
                    <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-check"></use></svg>
                    <div class="min-w-0 flex-1">
                        <p>@mensaje</p>
                        <span class="bemo-notification-countdown" data-notification-countdown></span>
                    </div>
                    <button type="button" class="bemo-notification-close" data-notification-close aria-label="Cerrar notificación">&times;</button>
                </div>
                <div class="bemo-notification-progress" data-notification-progress></div>
            </div>
        </div>
    }

    <section class="grid gap-4 lg:grid-cols-3">
        <div class="bemo-stat">
            <div class="bemo-stat-icon"><svg class="bemo-icon" viewBox="0 0 24 24">
                <use href="#icon-users"></use>
            </svg></div>
            <div>
                <p class="bemo-stat-label">Total de empleados</p>
                <p class="bemo-stat-value">@Model.EmpleadosTotales</p>
            </div>
        </div>
        <div class="bemo-stat">
            <div class="bemo-stat-icon"><svg class="bemo-icon" viewBox="0 0 24 24">
                <use href="#icon-check"></use>
            </svg></div>
            <div>
                <p class="bemo-stat-label">Activos</p>
                <p class="bemo-stat-value">@Model.EmpleadosActivos</p>
            </div>
        </div>
        <div class="bemo-stat">
            <div class="bemo-stat-icon"><svg class="bemo-icon" viewBox="0 0 24 24">
                <use href="#icon-ban"></use>
            </svg></div>
            <div>
                <p class="bemo-stat-label">Inactivos</p>
                <p class="bemo-stat-value">@Model.EmpleadosInactivos</p>
            </div>
        </div>
    </section>

    <form method="get" class="grid gap-4 lg:grid-cols-[1.25fr_1fr_1fr]" data-server-search>
        <div class="relative">
            <button class="absolute left-3 top-2.5 z-10 rounded-md p-1 text-[#381F12]" type="submit"
                    aria-label="Buscar empleados">
                <svg class="bemo-icon" viewBox="0 0 24 24">
                    <use href="#icon-search"></use>
                </svg>
            </button>
            <input class="bemo-input pl-12" type="search" name="busqueda" value="@Model.Busqueda"
                   placeholder="Buscar por DUI o nombre..." />
        </div>
        <select class="bemo-select" name="departamento" aria-label="Filtrar por departamento"
                onchange="this.form.submit()">
            <option value=""
                    selected="@(string.IsNullOrWhiteSpace(Model.DepartamentoSeleccionado) ? "selected" : null)">Todos los
                departamentos</option>
                @foreach (var departamento in Model.Departamentos)
                {
                    <option value="@departamento.NombreDepartamento"
                            selected="@(departamento.NombreDepartamento == Model.DepartamentoSeleccionado ? "selected" : null)">
                        @departamento.NombreDepartamento</option>
                    }
                </select>
                <select class="bemo-select" name="estado" aria-label="Filtrar por estado" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.EstadoSeleccionado) ? "selected" : null)">Todos
                        los estados</option>
                        <option value="ACTIVO" selected="@(Model.EstadoSeleccionado == "ACTIVO" ? "selected" : null)">Activo
                        </option>
                        <option value="INACTIVO" selected="@(Model.EstadoSeleccionado == "INACTIVO" ? "selected" : null)">Inactivo
                        </option>
                    </select>
                </form>

                <section class="bemo-card overflow-hidden">
                    <div class="bemo-table-wrap">
                        <table class="bemo-table" data-filter-table="employees">
                            <thead>
                                <tr>
                                    <th>DUI</th>
                                    <th>Nombre</th>
                                    <th>Departamento</th>
                                    <th>Cargo</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ListaEmpleados.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="text-center">No hay empleados para mostrar.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var empleado in Model.ListaEmpleados)
                                    {
                                        var contrato = empleado.Contratos.FirstOrDefault();
                                        var departamento = contrato?.Departamento?.NombreDepartamento ?? "Sin departamento";
                                        var cargo = contrato?.Cargo?.NombreCargo ?? "Sin cargo";
                                        var nombreCompleto = $"{empleado.Nombre} {empleado.Apellido}".Trim();
                                        var afp = empleado.Afp?.NombreAfp ?? "No registrado";
                                        var municipio = empleado.Direccion?.Distrito?.NombreDistrito ?? "No registrado";
                                        var departamentoUbicacion = empleado.Direccion?.Distrito?.DepartamentoUbicacion?.NombreDepartamentoUbicacion ?? "No registrado";
                                        var salarioBruto = contrato is null ? "No registrado" : contrato.SalarioBruto.ToString("N2");
                                        var fechaNacimiento = empleado.FechaNac == DateOnly.MinValue
                                            ? "No registrado"
                                            : empleado.FechaNac.ToString("dd/MM/yyyy");
                                        var fechaContratacion = contrato is null
                                            ? "No registrado"
                                            : contrato.FechaContratacion.ToString("dd/MM/yyyy");
                                        var fechaCulminacion = contrato?.FechaCulminacion is DateOnly fechaFin
                                            ? fechaFin.ToString("dd/MM/yyyy")
                                            : "No registrada";
                                        var activo = string.Equals(empleado.Estado, "ACTIVO", StringComparison.OrdinalIgnoreCase);
                                        var claseEstado = activo ? "bemo-status-green" : "bemo-status-red";
                                        var textoEstado = activo ? "Activo" : "Inactivo";
                                        <tr
                                            data-filter-value="@($"{empleado.Dui} {empleado.Nombre} {empleado.Apellido} {departamento} {cargo}")">
                                            <td>@empleado.Dui</td>
                                            <td>@empleado.Nombre @empleado.Apellido</td>
                                            <td>@departamento</td>
                                            <td>@cargo</td>
                                            <td><span class="bemo-status @claseEstado">@textoEstado</span></td>
                                            <td>
                                                <button class="bemo-link-action mr-3 cursor-pointer" type="button"
                                                        data-employee-view
                                                        data-employee-id="@empleado.IdEmpleado"
                                                        data-employee-dui="@empleado.Dui"
                                                        data-employee-name="@nombreCompleto"
                                                        data-employee-nit="@(empleado.Nit ?? "No registrado")"
                                                        data-employee-isss="@empleado.NumeroIsss"
                                                        data-employee-phone="@empleado.Telefono"
                                                        data-employee-email="@(empleado.Correo ?? "No registrado")"
                                                        data-employee-birth-date="@fechaNacimiento"
                                                        data-employee-status="@textoEstado"
                                                        data-employee-afp="@afp"
                                                        data-employee-street="@(empleado.Direccion?.NombreCalle ?? "No registrada")"
                                                        data-employee-house-number="@(empleado.Direccion?.NumeroCasa ?? "No registrado")"
                                                        data-employee-municipality="@municipio"
                                                        data-employee-location-department="@departamentoUbicacion"
                                                        data-employee-contract-id="@(contrato?.IdContrato.ToString() ?? "No registrado")"
                                                        data-employee-contract-type="@(contrato?.TipoContrato?.NombreTipoContrato ?? "No registrado")"
                                                        data-employee-position="@cargo"
                                                        data-employee-department="@departamento"
                                                        data-employee-salary="@salarioBruto"
                                                        data-employee-contract-start="@fechaContratacion"
                                                        data-employee-contract-end="@fechaCulminacion"
                                                        data-employee-contract-status="@(contrato?.Estado ?? "No registrado")">
                                                    <svg
                                                    class="bemo-icon-sm inline" viewBox="0 0 24 24">
                                                    <use href="#icon-eye"></use>
                                                </svg> Ver</button>
                                                <span class="text-[#C5A77B]">|</span>
                                                <a asp-area="@areaActual" asp-controller="Empleados" asp-action="Editar"
                                                   asp-route-id="@empleado.IdEmpleado"
                                                   class="bemo-link-action ml-3 cursor-pointer"><svg
                                                    class="bemo-icon-sm inline" viewBox="0 0 24 24">
                                                    <use href="#icon-edit"></use>
                                                </svg> Editar</a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <nav class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center" aria-label="Paginación de empleados">
                    <p class="text-sm text-[#684026]">Mostrando @inicio - @fin de @Model.TotalRegistros empleados</p>
                    <div class="flex flex-wrap items-center gap-2">
                        @if (Model.PaginaActual > 1)
                        {
                            <a class="bemo-button bemo-button-secondary" href="@UrlPagina(Model.PaginaActual - 1)">Anterior</a>
                        }

                        @if (Model.TotalPaginas <= 7)
                        {
                            @for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                            {
                                var clasePagina = pagina == Model.PaginaActual ? "bemo-button bemo-button-primary" : "bemo-button bemo-button-secondary";
                                <a class="@clasePagina" href="@UrlPagina(pagina)">@pagina</a>
                            }
                        }
                        else
                        {
                            var paginaInicio = Math.Max(2, Model.PaginaActual - 2);
                            var paginaFin = Math.Min(Model.TotalPaginas - 1, Model.PaginaActual + 2);
                            var clasePrimera = Model.PaginaActual == 1 ? "bemo-button bemo-button-primary" : "bemo-button bemo-button-secondary";
                            var claseUltima = Model.PaginaActual == Model.TotalPaginas ? "bemo-button bemo-button-primary" :
                  "bemo-button bemo-button-secondary";

                            <a class="@clasePrimera" href="@UrlPagina(1)">1</a>
                            @if (paginaInicio > 2)
                            {
                                <span class="flex items-center px-1 text-[#684026]">...</span>
                            }
                            @for (var pagina = paginaInicio; pagina <= paginaFin; pagina++)
                            {
                                var clasePagina = pagina == Model.PaginaActual ? "bemo-button bemo-button-primary" : "bemo-button bemo-button-secondary";
                                <a class="@clasePagina" href="@UrlPagina(pagina)">@pagina</a>
                            }
                            @if (paginaFin < Model.TotalPaginas - 1)
                            {
                                <span class="flex items-center px-1 text-[#684026]">...</span>
                            }
                            <a class="@claseUltima" href="@UrlPagina(Model.TotalPaginas)">@Model.TotalPaginas</a>
                        }

                        @if (Model.PaginaActual < Model.TotalPaginas)
                        {
                            <a class="bemo-button bemo-button-secondary" href="@UrlPagina(Model.PaginaActual + 1)">Siguiente</a>
                        }
                    </div>
                </nav>
            </div>

        <div class="fixed inset-0 z-50 hidden bg-black/50 p-4" data-employee-modal aria-hidden="true">
            <section class="relative mx-auto max-h-full max-w-5xl overflow-y-auto rounded-xl bg-white p-5 shadow-2xl md:p-8"
                     role="dialog" aria-modal="true" aria-labelledby="employee-modal-title">
                <button type="button" class="absolute right-4 top-4 rounded-md p-2 text-2xl leading-none text-[#684026] hover:bg-[#F7F0E2]"
                        data-employee-modal-close aria-label="Cerrar detalle">&times;</button>

                <div class="pr-10">
                    <p class="bemo-kicker">Ficha del empleado</p>
                    <h2 id="employee-modal-title" class="bemo-title mt-2" data-employee-field="name">Detalle del empleado</h2>
                    <p class="bemo-subtitle mt-2">Información personal, de contacto, ubicación y contrato.</p>
                </div>

                <div class="mt-6 grid gap-5 lg:grid-cols-2">
                    <section class="bemo-card p-5">
                        <h3 class="text-lg font-extrabold">Datos personales</h3>
                        <dl class="mt-4 grid gap-3 sm:grid-cols-2">
                            <div><dt class="bemo-label">Código</dt><dd data-employee-field="id"></dd></div>
                            <div><dt class="bemo-label">Estado</dt><dd data-employee-field="status"></dd></div>
                            <div><dt class="bemo-label">DUI</dt><dd data-employee-field="dui"></dd></div>
                            <div><dt class="bemo-label">NIT</dt><dd data-employee-field="nit"></dd></div>
                            <div><dt class="bemo-label">ISSS</dt><dd data-employee-field="isss"></dd></div>
                            <div><dt class="bemo-label">Fecha de nacimiento</dt><dd data-employee-field="birth-date"></dd></div>
                            <div><dt class="bemo-label">Teléfono</dt><dd data-employee-field="phone"></dd></div>
                            <div><dt class="bemo-label">Correo electrónico</dt><dd data-employee-field="email"></dd></div>
                            <div><dt class="bemo-label">AFP</dt><dd data-employee-field="afp"></dd></div>
                        </dl>
                    </section>

                    <section class="bemo-card p-5">
                        <h3 class="text-lg font-extrabold">Dirección</h3>
                        <dl class="mt-4 grid gap-3 sm:grid-cols-2">
                            <div><dt class="bemo-label">Calle</dt><dd data-employee-field="street"></dd></div>
                            <div><dt class="bemo-label">Número de casa</dt><dd data-employee-field="house-number"></dd></div>
                            <div><dt class="bemo-label">Municipio</dt><dd data-employee-field="municipality"></dd></div>
                            <div><dt class="bemo-label">Departamento</dt><dd data-employee-field="location-department"></dd></div>
                        </dl>
                    </section>
                </div>

                <section class="bemo-card mt-5 p-5">
                    <h3 class="text-lg font-extrabold">Contrato actual</h3>
                    <dl class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                        <div><dt class="bemo-label">Código de contrato</dt><dd data-employee-field="contract-id"></dd></div>
                        <div><dt class="bemo-label">Tipo de contrato</dt><dd data-employee-field="contract-type"></dd></div>
                        <div><dt class="bemo-label">Estado</dt><dd data-employee-field="contract-status"></dd></div>
                        <div><dt class="bemo-label">Cargo</dt><dd data-employee-field="position"></dd></div>
                        <div><dt class="bemo-label">Departamento laboral</dt><dd data-employee-field="department"></dd></div>
                        <div><dt class="bemo-label">Salario bruto</dt><dd data-employee-field="salary"></dd></div>
                        <div><dt class="bemo-label">Fecha de contratación</dt><dd data-employee-field="contract-start"></dd></div>
                        <div><dt class="bemo-label">Fecha de culminación</dt><dd data-employee-field="contract-end"></dd></div>
                    </dl>
                </section>
            </section>
        </div>

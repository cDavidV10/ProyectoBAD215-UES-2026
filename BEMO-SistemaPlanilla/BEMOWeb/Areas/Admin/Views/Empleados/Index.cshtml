@{
    ViewData["Title"] = "Empleados";
}

<div class="space-y-6">
    <header class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
        <div>
            <p class="bemo-kicker">Administración</p>
            <h1 class="bemo-title mt-2">Empleados</h1>
            <p class="bemo-subtitle mt-2">Administra la información del personal.</p>
        </div>
        <a asp-controller="Empleados" asp-action="Nuevo" class="bemo-button bemo-button-primary self-start">
            <svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-plus"></use></svg>
            Nuevo empleado
        </a>
    </header>

    <section class="grid gap-4 lg:grid-cols-3">
        <div class="bemo-stat"><div class="bemo-stat-icon"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-users"></use></svg></div><div><p class="bemo-stat-label">Total de empleados</p><p class="bemo-stat-value">128</p></div></div>
        <div class="bemo-stat"><div class="bemo-stat-icon"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-check"></use></svg></div><div><p class="bemo-stat-label">Activos</p><p class="bemo-stat-value">122</p></div></div>
        <div class="bemo-stat"><div class="bemo-stat-icon"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-ban"></use></svg></div><div><p class="bemo-stat-label">Inactivos</p><p class="bemo-stat-value">6</p></div></div>
    </section>

    <section class="grid gap-4 lg:grid-cols-[1.25fr_1fr_1fr]">
        <div class="relative">
            <svg class="bemo-icon absolute left-4 top-3 text-[#381F12]" viewBox="0 0 24 24"><use href="#icon-search"></use></svg>
            <input class="bemo-input pl-12" type="search" placeholder="Buscar por nombre o código..." data-filter-input="employees" />
        </div>
        <select class="bemo-select" aria-label="Filtrar por departamento" data-filter-select="employees">
            <option>Todos los departamentos</option><option>Producción</option><option>Recursos Humanos</option><option>Mantenimiento</option><option>Administración</option>
        </select>
        <select class="bemo-select" aria-label="Filtrar por estado"><option>Todos los estados</option><option>Activo</option><option>Inactivo</option></select>
    </section>

    <section class="bemo-card overflow-hidden">
        <div class="bemo-table-wrap">
            <table class="bemo-table" data-filter-table="employees">
                <thead><tr><th>Código</th><th>Nombre</th><th>Departamento</th><th>Cargo</th><th>Estado</th><th>Acciones</th></tr></thead>
                <tbody>
                    <tr data-filter-value="EMP-001 Carlos Andrés Martínez López Producción Operario de producción"><td>EMP-001</td><td> Carlos Andrés Martínez López</td><td>Producción</td><td>Operario de producción</td><td><span class="bemo-status bemo-status-green">Activo</span></td><td><button class="bemo-link-action mr-3" type="button"><svg class="bemo-icon-sm inline" viewBox="0 0 24 24"><use href="#icon-eye"></use></svg> Ver</button><span class="text-[#C5A77B]">|</span><button class="bemo-link-action ml-3" type="button"><svg class="bemo-icon-sm inline" viewBox="0 0 24 24"><use href="#icon-edit"></use></svg> Editar</button></td></tr>
                    <tr data-filter-value="EMP-002 María Elena Hernández Rivera Recursos Humanos Analista de talento humano"><td>EMP-002</td><td>María Elena Hernández Rivera</td><td>Recursos Humanos</td><td>Analista de talento humano</td><td><span class="bemo-status bemo-status-green">Activo</span></td><td><button class="bemo-link-action mr-3" type="button"><svg class="bemo-icon-sm inline" viewBox="0 0 24 24"><use href="#icon-eye"></use></svg> Ver</button><span class="text-[#C5A77B]">|</span><button class="bemo-link-action ml-3" type="button"><svg class="bemo-icon-sm inline" viewBox="0 0 24 24"><use href="#icon-edit"></use></svg> Editar</button></td></tr>
                    <tr data-filter-value="EMP-003 José Ricardo Pérez Aguilar Mantenimiento Técnico de mantenimiento"><td>EMP-003</td><td>José Ricardo Pérez Aguilar</td><td>Mantenimiento</td><td>Técnico de mantenimiento</td><td><span class="bemo-status bemo-status-red">Inactivo</span></td><td><button class="bemo-link-action mr-3" type="button"><svg class="bemo-icon-sm inline" viewBox="0 0 24 24"><use href="#icon-eye"></use></svg> Ver</button><span class="text-[#C5A77B]">|</span><button class="bemo-link-action ml-3" type="button"><svg class="bemo-icon-sm inline" viewBox="0 0 24 24"><use href="#icon-edit"></use></svg> Editar</button></td></tr>
                    <tr data-filter-value="EMP-004 Ana Gabriela Castro Morales Administración Asistente administrativa"><td>EMP-004</td><td>Ana Gabriela Castro Morales</td><td>Administración</td><td>Asistente administrativa</td><td><span class="bemo-status bemo-status-green">Activo</span></td><td><button class="bemo-link-action mr-3" type="button"><svg class="bemo-icon-sm inline" viewBox="0 0 24 24"><use href="#icon-eye"></use></svg> Ver</button><span class="text-[#C5A77B]">|</span><button class="bemo-link-action ml-3" type="button"><svg class="bemo-icon-sm inline" viewBox="0 0 24 24"><use href="#icon-edit"></use></svg> Editar</button></td></tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

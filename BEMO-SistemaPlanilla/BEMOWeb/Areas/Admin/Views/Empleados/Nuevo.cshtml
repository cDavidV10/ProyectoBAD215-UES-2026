@model BEMOWeb.Models.NuevoEmpleadoModel

@{
    ViewData["Title"] = "Nuevo empleado";
    var areaActual = ViewContext.RouteData.Values["area"]?.ToString() ?? "Admin";
    var fechaMaximaNacimiento = DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd");

}

<div class="space-y-5">
    <div><p class="bemo-breadcrumb">Administración <span class="mx-2">›</span> Empleados</p><h1 class="bemo-title mt-3">Nuevo empleado</h1></div>
    <form asp-area="@areaActual" asp-controller="Empleados" asp-action="Nuevo" method="post" class="bemo-card space-y-3 p-4 md:p-5" data-employee-form>
        @Html.AntiForgeryToken()
        <div class="bemo-alert bemo-alert-error" data-client-validation-message role="alert" hidden>
            <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-ban"></use></svg>
            <span>Revisa los campos marcados antes de guardar.</span>
        </div>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bemo-alert bemo-alert-error" role="alert">
                <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-ban"></use></svg>
                <div>
                    <strong>Corrige los campos marcados antes de guardar.</strong>
                    <div asp-validation-summary="All" class="text-sm"></div>
                </div>
            </div>
        }

        <div class="bemo-section-bar">Datos personales</div>
        <div class="grid gap-4 md:grid-cols-3">
            <div>
                <label class="bemo-label bemo-required" for="nombre">Nombres</label>
                <input class="bemo-input" id="nombre" name="Empleado.Nombre" value="@Model.Empleado.Nombre" placeholder="Ingrese nombres" maxlength="50" pattern="[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]+(?:[ '\-][A-Za-zÁÉÍÓÚÜÑáéíóúüñ]+)*" title="Use únicamente letras, espacios, apóstrofes o guiones." autocomplete="given-name" required />
                <span asp-validation-for="Empleado.Nombre" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" for="apellido">Apellidos</label>
                <input class="bemo-input" id="apellido" name="Empleado.Apellido" value="@Model.Empleado.Apellido" placeholder="Ingrese apellidos" maxlength="20" pattern="[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]+(?:[ '\-][A-Za-zÁÉÍÓÚÜÑáéíóúüñ]+)*" title="Use únicamente letras, espacios, apóstrofes o guiones." autocomplete="family-name" required />
                <span asp-validation-for="Empleado.Apellido" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" for="fecha-nac">Fecha de nacimiento</label>
                <input class="bemo-input" id="fecha-nac" name="Empleado.FechaNac" type="date" value="@(Model.Empleado.FechaNac == DateOnly.MinValue ? "" : Model.Empleado.FechaNac.ToString("yyyy-MM-dd"))" max="@fechaMaximaNacimiento" title="El empleado debe tener al menos 18 años." required />
                <span asp-validation-for="Empleado.FechaNac" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" for="dui">DUI</label>
                <input class="bemo-input" id="dui" name="Empleado.Dui" value="@Model.Empleado.Dui" placeholder="00000000-0" maxlength="10" pattern="[0-9]{8}-[0-9]" title="El DUI debe tener el formato 00000000-0." inputmode="numeric" autocomplete="off" required />
                <span asp-validation-for="Empleado.Dui" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label" for="nit">NIT</label>
                <input class="bemo-input" id="nit" name="Empleado.Nit" value="@Model.Empleado.Nit" placeholder="0000-000000-000-0 o 00000000-0" maxlength="17" pattern="(?:[0-9]{4}-[0-9]{6}-[0-9]{3}-[0-9]|[0-9]{8}-[0-9])" title="El NIT debe tener el formato 0000-000000-000-0 o el formato de DUI 00000000-0." inputmode="numeric" autocomplete="off" />
                <span asp-validation-for="Empleado.Nit" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" for="isss">Número ISSS</label>
                <input class="bemo-input" id="isss" name="Empleado.NumeroIsss" value="@Model.Empleado.NumeroIsss" placeholder="Ingrese número ISSS" maxlength="15" pattern="[0-9]{1,15}" title="El ISSS solo puede contener dígitos." inputmode="numeric" autocomplete="off" required />
                <span asp-validation-for="Empleado.NumeroIsss" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" for="telefono">Teléfono</label>
                <input class="bemo-input" id="telefono" name="Empleado.Telefono" value="@Model.Empleado.Telefono" placeholder="0000-0000" maxlength="9" pattern="[0-9]{4}-[0-9]{4}" title="El teléfono debe tener el formato 0000-0000." inputmode="tel" autocomplete="tel" required />
                <span asp-validation-for="Empleado.Telefono" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div class="md:col-span-2">
                <label class="bemo-label" for="correo">Correo electrónico</label>
                <input class="bemo-input" id="correo" name="Empleado.Correo" value="@Model.Empleado.Correo" type="email" maxlength="100" placeholder="correo@ejemplo.com" autocomplete="email" />
                <span asp-validation-for="Empleado.Correo" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
        </div>

        <div class="bemo-divider pt-2"><div class="bemo-section-bar">Dirección</div></div>
        <div class="grid gap-4 md:grid-cols-2">
            <div>
                <label class="bemo-label bemo-required" for="departamento-ubicacion">Departamento</label>
                <select class="bemo-select" id="departamento-ubicacion" name="IdDepartamentoUbicacion" data-location-department required>
                    <option value="">Seleccione departamento</option>
                    @foreach (var departamento in Model.DepartamentosUbicacion)
                    {
                        <option value="@departamento.IdDepartamentoUbicacion" selected="@(Model.IdDepartamentoUbicacion == departamento.IdDepartamentoUbicacion ? "selected" : null)">@departamento.NombreDepartamentoUbicacion</option>
                    }
                </select>
                <span asp-validation-for="IdDepartamentoUbicacion" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" for="municipio-ubicacion">Municipio</label>
                <select class="bemo-select" id="municipio-ubicacion" name="IdMunicipio" data-location-municipality required disabled>
                    <option value="">Seleccione municipio</option>
                    @foreach (var municipio in Model.Municipios)
                    {
                        <option value="@municipio.IdMunicipio" data-department-id="@municipio.IdDepartamentoUbicacion" selected="@(Model.IdMunicipio == municipio.IdMunicipio ? "selected" : null)">@municipio.NombreMunicipio</option>
                    }
                </select>
                <span asp-validation-for="IdMunicipio" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" for="nombre-calle">Calle</label>
                <input class="bemo-input" id="nombre-calle" name="NombreCalle" value="@Model.NombreCalle" placeholder="Ej. Calle principal #12" maxlength="50" pattern="[A-Za-z0-9ÁÉÍÓÚÜÑáéíóúüñ][A-Za-z0-9ÁÉÍÓÚÜÑáéíóúüñ .,#/\-]*" title="Ingrese una calle con letras, números y signos de dirección válidos." required />
                <span asp-validation-for="NombreCalle" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" for="numero-casa">Número de casa</label>
                <input class="bemo-input" id="numero-casa" name="NumeroCasa" value="@Model.NumeroCasa" placeholder="Ej. 12-A" maxlength="10" pattern="[A-Za-z0-9ÁÉÍÓÚÜÑáéíóúüñ][A-Za-z0-9ÁÉÍÓÚÜÑáéíóúüñ .#/\-]*" title="Ingrese un número de casa válido." required />
                <span asp-validation-for="NumeroCasa" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
        </div>

        <div class="bemo-divider pt-2"><div class="bemo-section-bar">Información complementaria</div></div>
        <div class="grid gap-4 md:grid-cols-2">
            <div>
                <label class="bemo-label bemo-required" for="afp">AFP</label>
                <select class="bemo-select" id="afp" name="Empleado.IdAfp" required>
                    <option value="">Seleccione AFP</option>
                    @foreach (var afp in Model.Afps)
                    {
                        <option value="@afp.IdAfp" selected="@(Model.Empleado.IdAfp == afp.IdAfp ? "selected" : null)">@afp.NombreAfp</option>
                    }
                </select>
                <span asp-validation-for="Empleado.IdAfp" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
        </div>

        <div class="bemo-divider pt-2"><div class="bemo-section-bar">Contrato inicial</div></div>
        <div class="grid gap-4 md:grid-cols-3">
            <div>
                <label class="bemo-label bemo-required" for="departamento-laboral">Departamento laboral</label>
                <select class="bemo-select" id="departamento-laboral" name="IdDepartamento" required>
                    <option value="">Seleccione departamento</option>
                    @foreach (var departamento in Model.Departamentos)
                    {
                        <option value="@departamento.IdDepartamento" selected="@(Model.IdDepartamento == departamento.IdDepartamento ? "selected" : null)">@departamento.NombreDepartamento</option>
                    }
                </select>
                <span asp-validation-for="IdDepartamento" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" for="cargo">Cargo</label>
                <select class="bemo-select" id="cargo" name="IdCargo" required>
                    <option value="">Seleccione cargo</option>
                    @foreach (var cargo in Model.Cargos)
                    {
                        <option value="@cargo.IdCargo" selected="@(Model.IdCargo == cargo.IdCargo ? "selected" : null)">@cargo.NombreCargo ($@cargo.RangoMinimoCargo.ToString("N2") - $@cargo.RangoMaximoCargo.ToString("N2"))</option>
                    }
                </select>
                <span asp-validation-for="IdCargo" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" for="tipo-contrato">Tipo de contrato</label>
                <select class="bemo-select" id="tipo-contrato" name="IdTipoContrato" data-contract-type required>
                    <option value="">Seleccione tipo de contrato</option>
                    @foreach (var tipo in Model.TiposContrato)
                    {
                        <option value="@tipo.IdTipoContrato" selected="@(Model.IdTipoContrato == tipo.IdTipoContrato ? "selected" : null)">@tipo.NombreTipoContrato</option>
                    }
                </select>
                <span asp-validation-for="IdTipoContrato" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" for="salario">Salario bruto</label>
                <input class="bemo-input" id="salario" name="SalarioBruto" value="@Model.SalarioBruto" type="number" min="0.01" max="99999999.99" step="0.01" placeholder="Ingrese salario" required />
                <span asp-validation-for="SalarioBruto" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" for="fecha-contratacion">Fecha de contratación</label>
                <input class="bemo-input" id="fecha-contratacion" name="FechaContratacion" value="@(Model.FechaContratacion?.ToString("yyyy-MM-dd"))" type="date" data-contract-start required />
                <span asp-validation-for="FechaContratacion" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
            <div>
                <label class="bemo-label" for="fecha-culminacion">Fecha de culminación</label>
                <input class="bemo-input" id="fecha-culminacion" name="FechaCulminacion" value="@(Model.FechaCulminacion?.ToString("yyyy-MM-dd"))" type="date" data-contract-end />
                <span asp-validation-for="FechaCulminacion" class="bemo-validation-message text-sm text-red-700"></span>
            </div>
        </div>

        <div class="bemo-info"><svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-info"></use></svg>El empleado se registra inicialmente como ACTIVO, según el valor predeterminado de la base de datos.</div>
        <div class="flex flex-wrap gap-3 pt-2"><button class="bemo-button bemo-button-primary" type="submit"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-save"></use></svg>Guardar empleado</button><a asp-area="@areaActual" asp-controller="Empleados" asp-action="Index" class="bemo-button bemo-button-secondary">Cancelar</a></div>
    </form>
</div>

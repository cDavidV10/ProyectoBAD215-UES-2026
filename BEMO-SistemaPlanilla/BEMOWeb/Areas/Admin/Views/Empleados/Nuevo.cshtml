@{
    ViewData["Title"] = "Nuevo empleado";
}

<div class="space-y-5">
    <div><p class="bemo-breadcrumb">Administración <span class="mx-2">›</span> Empleados</p><h1 class="bemo-title mt-3">Nuevo empleado</h1></div>
    <form class="bemo-card space-y-3 p-4 md:p-5" data-demo-form>
        <div class="bemo-section-bar">Datos personales</div>
        <div class="grid gap-4 md:grid-cols-3">
            <div><label class="bemo-label bemo-required">Nombres</label><input class="bemo-input" placeholder="Ingrese nombres" required /></div>
            <div><label class="bemo-label bemo-required">Apellidos</label><input class="bemo-input" placeholder="Ingrese apellidos" required /></div>
            <div><label class="bemo-label">Fecha de nacimiento</label><input class="bemo-input" type="date" /></div>
            <div><label class="bemo-label bemo-required">DUI</label><input class="bemo-input" placeholder="Ingrese DUI" required /></div>
            <div><label class="bemo-label">NIT</label><input class="bemo-input" placeholder="Ingrese NIT" /></div>
            <div><label class="bemo-label">Teléfono</label><input class="bemo-input" placeholder="Ingrese teléfono" /></div>
            <div class="md:col-span-2"><label class="bemo-label">Correo electrónico</label><input class="bemo-input" type="email" placeholder="Ingrese correo electrónico" /></div>
        </div>
        <div class="bemo-divider pt-2"><div class="bemo-section-bar">Dirección</div></div>
        <div class="grid gap-4 md:grid-cols-3">
            <div><label class="bemo-label">Departamento</label><select class="bemo-select"><option>Seleccione departamento</option><option>San Salvador</option><option>La Libertad</option></select></div>
            <div><label class="bemo-label">Municipio</label><select class="bemo-select"><option>Seleccione municipio</option></select></div>
            <div><label class="bemo-label">Distrito</label><select class="bemo-select"><option>Seleccione distrito</option></select></div>
            <div class="md:col-span-3"><label class="bemo-label">Dirección detallada</label><input class="bemo-input" placeholder="Ingrese dirección detallada" /></div>
        </div>
        <div class="bemo-divider pt-2"><div class="bemo-section-bar">Información complementaria</div></div>
        <div class="grid gap-4 md:grid-cols-2">
            <div><label class="bemo-label">AFP</label><select class="bemo-select"><option>Seleccione AFP</option><option>AFP Crecer</option><option>AFP Confía</option></select></div>
            <div><label class="bemo-label">Estado</label><select class="bemo-select"><option>Seleccione estado</option><option>Activo</option><option>Inactivo</option></select></div>
        </div>
        <div class="flex flex-wrap gap-3 pt-2"><button class="bemo-button bemo-button-primary" type="submit"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-save"></use></svg>Guardar empleado</button><a asp-action="Index" class="bemo-button bemo-button-secondary">Cancelar</a></div>
    </form>
</div>

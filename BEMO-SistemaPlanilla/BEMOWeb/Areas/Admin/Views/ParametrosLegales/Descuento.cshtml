@model BEMOWeb.Models.ParametroDescuentoLeyModel

@{
    var edicion = Model.IdDescuento.HasValue;
    ViewData["Title"] = edicion ? "Editar descuento de ley" : "Nueva vigencia de descuento";
}

<div class="mx-auto max-w-3xl space-y-5">
    <div>
        <p class="bemo-kicker">Administración › Parámetros legales</p>
        <h1 class="bemo-title mt-2">@(edicion ? "Editar descuento de ley" : "Nueva vigencia de descuento")</h1>
        <p class="bemo-subtitle mt-2">@(edicion ? "Actualiza un parámetro que todavía no haya sido usado por una planilla cerrada." : "Registra el porcentaje que aplicará a las planillas del periodo indicado.")</p>
    </div>

    <form asp-action="GuardarDescuento" method="post" class="bemo-card space-y-5 p-5 md:p-8">
        @Html.AntiForgeryToken()
        <input asp-for="IdDescuento" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="bemo-alert bemo-alert-error"></div>
        <div class="grid gap-5 md:grid-cols-2">
            <div>
                <label class="bemo-label bemo-required" asp-for="IdTipoDescuento">Tipo de descuento</label>
                <select class="bemo-select" asp-for="IdTipoDescuento">
                    <option value="">Seleccione ISSS o AFP</option>
                    @foreach (var tipo in Model.TiposDescuento)
                    {
                        <option value="@tipo.IdTipoDescuento">@tipo.NombreTipoDescuento</option>
                    }
                </select>
                <span asp-validation-for="IdTipoDescuento" class="bemo-validation-message"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" asp-for="PorcentajeDescuento">Porcentaje</label>
                <div class="relative"><input class="bemo-input pr-10" asp-for="PorcentajeDescuento" type="number" min="0.01" max="100" step="0.01" /><span class="absolute right-3 top-2.5 text-[#684026]">%</span></div>
                <span asp-validation-for="PorcentajeDescuento" class="bemo-validation-message"></span>
            </div>
            <div>
                <label class="bemo-label" asp-for="TopeMensual">Tope mensual</label>
                <input class="bemo-input" asp-for="TopeMensual" type="number" min="0.01" step="0.01" placeholder="Sin tope" />
                <span asp-validation-for="TopeMensual" class="bemo-validation-message"></span>
            </div>
            <div>
                <label class="bemo-label bemo-required" asp-for="FechaVigencia">Fecha de vigencia</label>
                <input class="bemo-input" asp-for="FechaVigencia" type="date" />
                <span asp-validation-for="FechaVigencia" class="bemo-validation-message"></span>
            </div>
        </div>
        <div class="bemo-info"><svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-info"></use></svg><span>Los cambios se aplican al calcular nuevas planillas cuya fecha de fin sea igual o posterior a la vigencia.</span></div>
        <div class="flex flex-wrap gap-3">
            <button type="submit" class="bemo-button bemo-button-primary"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-save"></use></svg>Guardar parámetro</button>
            <a asp-action="Index" class="bemo-button bemo-button-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

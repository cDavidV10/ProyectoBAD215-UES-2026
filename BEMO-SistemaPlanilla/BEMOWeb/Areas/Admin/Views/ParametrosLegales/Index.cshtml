@using System.Globalization
@model BEMOWeb.Models.ParametrosLegalesModel

@{
    ViewData["Title"] = "Parámetros legales";
    var mensaje = TempData["Mensaje"] as string;
    var error = TempData["Error"] as string;
    string Moneda(decimal? valor) => valor.HasValue
        ? valor.Value.ToString("C2", CultureInfo.GetCultureInfo("es-SV"))
        : "Sin tope";
}

<div class="space-y-5">
    <header class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
        <div>
            <p class="bemo-kicker">Administración</p>
            <h1 class="bemo-title mt-2">Parámetros legales</h1>
            <p class="bemo-subtitle mt-2">Consulta los porcentajes, topes y tramos de renta actualmente vigentes.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(mensaje) || !string.IsNullOrWhiteSpace(error))
    {
        <div class="bemo-notifications" aria-live="polite" aria-atomic="true">
            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="bemo-notification bemo-notification-success" data-notification data-notification-seconds="5" role="status">
                    <div class="bemo-notification-body">
                        <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-check"></use></svg>
                        <div class="min-w-0 flex-1"><p>@mensaje</p><span class="bemo-notification-countdown" data-notification-countdown></span></div>
                        <button type="button" class="bemo-notification-close" data-notification-close aria-label="Cerrar notificación">&times;</button>
                    </div>
                    <div class="bemo-notification-progress" data-notification-progress></div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="bemo-notification bemo-notification-error" data-notification data-notification-seconds="7" role="alert">
                    <div class="bemo-notification-body">
                        <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-ban"></use></svg>
                        <div class="min-w-0 flex-1"><p>@error</p><span class="bemo-notification-countdown" data-notification-countdown></span></div>
                        <button type="button" class="bemo-notification-close" data-notification-close aria-label="Cerrar notificación">&times;</button>
                    </div>
                    <div class="bemo-notification-progress" data-notification-progress></div>
                </div>
            }
        </div>
    }

    <div class="bemo-alert bemo-alert-success">
        <svg class="bemo-icon shrink-0" viewBox="0 0 24 24"><use href="#icon-info"></use></svg>
        <span>Solo se muestran los parámetros actualmente vigentes. El histórico se conserva para las planillas cerradas; para cambiar una tasa, registre una nueva vigencia.</span>
    </div>

    <section class="bemo-card overflow-hidden">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#E3D2AE] px-5 py-4">
            <div>
                <h2 class="text-xl font-extrabold">ISSS y AFP</h2>
                <p class="mt-1 text-sm text-[#684026]">Porcentajes de cotización y topes mensuales.</p>
            </div>
            <a asp-action="NuevoDescuento" class="bemo-button bemo-button-primary"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-plus"></use></svg>Nueva vigencia</a>
        </div>
        <div class="bemo-table-wrap">
            <table class="bemo-table min-w-[720px]">
                <thead><tr><th>Tipo</th><th>Porcentaje</th><th>Tope mensual</th><th>Vigencia</th><th>Acción</th></tr></thead>
                <tbody>
                    @if (Model.DescuentosLey.Count == 0)
                    {
                        <tr><td colspan="5" class="py-8 text-center text-[#684026]">No hay porcentajes de ley registrados.</td></tr>
                    }
                    else
                    {
                        foreach (var descuento in Model.DescuentosLey)
                        {
                            <tr>
                                <td class="font-semibold">@(descuento.TipoDescuento?.NombreTipoDescuento ?? "Sin tipo")</td>
                                <td>@descuento.PorcentajeDescuento.ToString("0.##")%</td>
                                <td>@Moneda(descuento.TopeMensual)</td>
                                <td>@descuento.FechaVigencia.ToString("dd/MM/yyyy")</td>
                                <td><a asp-action="EditarDescuento" asp-route-id="@descuento.IdDescuento" class="bemo-link-action"><svg class="bemo-icon-sm inline" viewBox="0 0 24 24"><use href="#icon-edit"></use></svg> Editar</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="bemo-card overflow-hidden">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#E3D2AE] px-5 py-4">
            <div>
                <h2 class="text-xl font-extrabold">Tramos de retención de renta</h2>
                <p class="mt-1 text-sm text-[#684026]">Rangos, porcentajes y valores fijos según la vigencia legal.</p>
            </div>
            <a asp-action="NuevaRenta" class="bemo-button bemo-button-primary"><svg class="bemo-icon" viewBox="0 0 24 24"><use href="#icon-plus"></use></svg>Nuevo tramo</a>
        </div>
        <div class="bemo-table-wrap">
            <table class="bemo-table min-w-[1050px]">
                <thead><tr><th>Tramo</th><th>Código</th><th>Rango mínimo</th><th>Rango máximo</th><th>Porcentaje</th><th>Valor fijo</th><th>Vigencia</th><th>Acción</th></tr></thead>
                <tbody>
                    @if (Model.Rentas.Count == 0)
                    {
                        <tr><td colspan="8" class="py-8 text-center text-[#684026]">No hay tramos de renta registrados.</td></tr>
                    }
                    else
                    {
                        foreach (var renta in Model.Rentas)
                        {
                            <tr>
                                <td class="font-semibold">@(renta.TipoRenta?.NombreTramo ?? "Sin tramo")</td>
                                <td>@renta.CodigoRenta</td>
                                <td>@Moneda(renta.RangoMinimoRenta)</td>
                                <td>@Moneda(renta.RangoMaximoRenta)</td>
                                <td>@renta.PorcentajeRenta.ToString("0.##")%</td>
                                <td>@Moneda(renta.ValorFijo)</td>
                                <td>@renta.FechaVigenciaRenta.ToString("dd/MM/yyyy")</td>
                                <td><a asp-action="EditarRenta" asp-route-id="@renta.IdRenta" class="bemo-link-action"><svg class="bemo-icon-sm inline" viewBox="0 0 24 24"><use href="#icon-edit"></use></svg> Editar</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

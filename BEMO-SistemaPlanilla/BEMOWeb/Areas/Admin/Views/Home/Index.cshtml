@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="space-y-6">
    <section class="bemo-card grid gap-6 p-6 md:grid-cols-[1.4fr_1fr] md:p-8">
        <div><p class="bemo-kicker">Administración</p><h1 class="bemo-title mt-2">Bienvenido, @(User.Identity?.Name ?? "vr24001")</h1><p class="bemo-subtitle mt-3 max-w-2xl">Administra la planilla, los contratos y los accesos al sistema desde un solo lugar.</p><p class="mt-4 font-semibold text-[#9F5F2F]">Selecciona un módulo del menú para comenzar.</p></div>
        <div class="rounded-xl bg-[#F7F0E2] p-5"><p class="font-bold text-[#684026]">Resumen de hoy</p><div class="mt-4 grid grid-cols-2 gap-3"><div class="rounded-lg bg-white p-4"><p class="text-sm text-[#804C2C]">Empleados activos</p><p class="mt-1 text-2xl font-extrabold">122</p></div><div class="rounded-lg bg-white p-4"><p class="text-sm text-[#804C2C]">Pendientes</p><p class="mt-1 text-2xl font-extrabold">6</p></div></div></div>
    </section>
    <section class="grid gap-4 md:grid-cols-3"><a asp-area="Admin" asp-controller="Empleados" asp-action="Index" class="bemo-card p-5 transition hover:-translate-y-1"><svg class="bemo-icon text-[#9F5F2F]" viewBox="0 0 24 24"><use href="#icon-users"></use></svg><h2 class="mt-3 font-extrabold">Gestionar empleados</h2><p class="mt-1 text-sm text-[#684026]">Consulta y actualiza la información del personal.</p></a><a asp-area="Admin" asp-controller="Planilla" asp-action="Index" class="bemo-card p-5 transition hover:-translate-y-1"><svg class="bemo-icon text-[#9F5F2F]" viewBox="0 0 24 24"><use href="#icon-calendar"></use></svg><h2 class="mt-3 font-extrabold">Revisar planilla</h2><p class="mt-1 text-sm text-[#684026]">Procesa la quincena y revisa los importes.</p></a><a asp-area="Admin" asp-controller="Auditoria" asp-action="Index" class="bemo-card p-5 transition hover:-translate-y-1"><svg class="bemo-icon text-[#9F5F2F]" viewBox="0 0 24 24"><use href="#icon-search"></use></svg><h2 class="mt-3 font-extrabold">Ver auditoría</h2><p class="mt-1 text-sm text-[#684026]">Consulta el historial de operaciones.</p></a></section>
</div>
